---
/**
 * The analytics consent banner (#667).
 *
 * Rendered hidden on every page of a host with Zaraz (src/utils/zaraz.ts) and
 * shown by src/utils/consent.ts only while the visitor has not answered, so a
 * returning visitor never sees it flash and a page without JavaScript asks for
 * nothing and loads nothing. The markup is the same for everyone, which keeps
 * the edge-cached HTML shareable: the answer lives in the browser.
 *
 * Accept and decline are the same button, side by side: the AEPD's cookie
 * guide asks for a refusal as easy and as visible as the acceptance. The
 * footer's control reopens it. Every word comes from the `consent` widget.
 */
import { PortableText } from "emdash/ui";
import PtLink from "./PtLink.astro";
import { ZARAZ_LOADER } from "../utils/zaraz";
import type { WidgetBlock } from "../utils/ui-labels";

interface Props {
	label: string;
	body: WidgetBlock[];
	accept: string;
	reject: string;
}

const { label, body, accept, reject } = Astro.props;
---
<section class="consent" data-consent-banner data-zaraz-src={ZARAZ_LOADER} data-withdraw-url="/api/consent-withdraw" aria-label={label} hidden>
	<div class="container consent__inner">
		<div class="consent__body"><PortableText value={body} components={{ mark: { link: PtLink } }} /></div>
		<div class="consent__actions">
			<button type="button" class="btn btn-dark" data-consent-accept>{accept}</button>
			<button type="button" class="btn btn-dark" data-consent-reject>{reject}</button>
		</div>
	</div>
</section>

<script>
	import { start } from "../utils/consent";
	start();
</script>

<style>
	/* PANEL chrome (#452) as a band across the foot of the viewport: hairline,
	   paper, the card shadow. Not modal — the page stays usable behind it. */
	.consent {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 90;
		background: var(--color-secondary);
		border-top: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
	}
	.consent[hidden] {
		display: none;
	}
	.consent__inner {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-4);
		align-items: center;
		justify-content: space-between;
		padding-block: var(--space-3);
	}
	.consent__body {
		flex: 1 1 28rem;
		min-width: 0;
		font-size: 16px;
		line-height: 1.5;
	}
	.consent__body :global(p) {
		margin: 0;
	}
	.consent__body :global(a) {
		color: inherit;
		text-decoration: underline dashed;
		text-underline-offset: 3px;
	}
	.consent__body :global(a:hover) {
		text-decoration-style: solid;
	}
	.consent__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
</style>
