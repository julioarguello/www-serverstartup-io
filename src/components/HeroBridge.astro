---
/**
 * HeroBridge — the opening of the systems-integration vertical (#531).
 *
 * The Vizcaya Bridge, between Portugalete and Las Arenas: first the two banks
 * with no bridge (the photograph with the bridge and the sky taken out), then
 * the bridge, whole, as an architect's drawing in its own red, then what plugs
 * into it — because the bridge IS the bus. Messages then travel along the
 * girder from one connector to one or several others, each in one of the six
 * verticals' colours. The founder's brief (2026-10-01): "tejemos lazos,
 * tejemos toda la red de integración".
 *
 * The band, the copy, the epigraph, the seal, the veil and the controls are the
 * scene every vertical shares (HeroScene.astro). What is the bridge's own:
 *
 * - The drawing is a raster on the photograph's frame (int-puente-plan.webp),
 *   in front of the veil because it never crosses a letter. What the script
 *   measures is its outline, built from geometry on the same frame
 *   (docs/design/hero-rotativo/bridge.py), shipped as path data, never drawn.
 * - The scene is level, the Las Arenas tower just past the column's right edge,
 *   and as high as the copy allows: the structure touches no letter; the thin
 *   lines (cables, hangers, stays) may pass behind the quotation and nothing
 *   else (founder, 2026-10-02).
 * - The connectors are the protocols (above the girder) and the platforms and
 *   Google Cloud services (below) the company has actually wired (evidence in
 *   the issue), from `panel_labels` → `bridge_plugs_up` / `bridge_plugs_down`;
 *   as many as fit, in that order, on two heights, each withheld where it would
 *   touch a letter, a stroke, another name or the band's edge.
 */
import { getEmDashCollection } from "emdash";
import { HERO_BRIDGE, HERO_BRIDGE_SIZES } from "../utils/hero-art";
import { FACE_BY_SLUG, FACE_ORDER } from "../utils/nav";
import HeroScene from "./HeroScene.astro";
import outline from "../assets/hero/int-puente.svg?raw";

interface Props {
	title: string;
	excerptHtml: string;
	ctaLabel: string;
	contactPath: string;
	quote: any[] | null;
	labels: { get: (widget: string, key: string, fallback: string) => string };
}
const { title, excerptHtml, ctaLabel, contactPath, quote, labels } = Astro.props;
const L = (k: string, fb: string) => labels.get("panel_labels", k, fb);
const list = (k: string) => L(k, "").split(",").map((p) => p.trim()).filter(Boolean).join("|");

/* the outline's path data, by group: the structure, which touches no letter, and the lines, which may
   pass behind the quotation */
const groups = Object.fromEntries([...outline.matchAll(/<g class="b-([a-z]+)">([\s\S]*?)<\/g>/g)].map((m) => [m[1], [...m[2].matchAll(/ d="([^"]+)"/g)].map((d) => d[1]).join(" ")]));
const hard = ["towers", "girder", "car"].map((k) => groups[k] ?? "").join(" ");
const soft = ["cables", "hangers", "stays"].map((k) => groups[k] ?? "").join(" ");

/* the messages wear the six verticals' colours, from the CMS, in the cube's order */
const { entries: serviceEntries } = await getEmDashCollection("services", { orderBy: { created_at: "asc" }, locale: Astro.currentLocale || "es" });
const colors = (serviceEntries ?? [])
	.map((e: any) => ({ key: FACE_BY_SLUG[e.slug ?? e.id], color: e.data.color as string | undefined }))
	.filter((f) => f.key && f.color)
	.sort((a, b) => FACE_ORDER.indexOf(a.key) - FACE_ORDER.indexOf(b.key))
	.map((f) => f.color)
	.join("|");
const pauseLabel = L("bridge_pause", "Pausar la animación");
const replayLabel = L("bridge_replay", "Repetir la animación");
---

<HeroScene scene="bridge" title={title} excerptHtml={excerptHtml} ctaLabel={ctaLabel} contactPath={contactPath} quote={quote} pauseLabel={pauseLabel} replayLabel={replayLabel} data={{ up: list("bridge_plugs_up"), down: list("bridge_plugs_down"), colors, hard, soft }}>
	<div slot="under" class="bridge__box bridge__art">
		<img class="bridge__banks" src={HERO_BRIDGE.banks} srcset={`${HERO_BRIDGE.banksSmall} 960w, ${HERO_BRIDGE.banks} 1320w`} sizes={HERO_BRIDGE_SIZES} width="1320" height="730" alt="" fetchpriority="high" decoding="async" />
	</div>
	<Fragment slot="over">
		<div class="bridge__box bridge__lines">
			<img class="bridge__plan" src={HERO_BRIDGE.plan} srcset={`${HERO_BRIDGE.planSmall} 960w, ${HERO_BRIDGE.plan} 1320w`} sizes={HERO_BRIDGE_SIZES} width="1320" height="406" alt="" decoding="async" />
		</div>
		<div class="bridge__bus" data-volatile></div>
	</Fragment>
</HeroScene>

<script>
	const hero = document.querySelector<HTMLElement>(".s-hero--bridge");
	if (hero) {
		const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const stage = hero.querySelector<HTMLElement>(".s-hero__stage")!;
		const bus = hero.querySelector<HTMLElement>(".bridge__bus")!;
		const copy = hero.querySelector<HTMLElement>(".s-hero__copy")!;
		const inner = hero.querySelector<HTMLElement>(".s-hero__inner")!;
		const pause = hero.querySelector<HTMLInputElement>(".scene__pause")!;
		const replay = hero.querySelector<HTMLButtonElement>(".scene__replay")!;
		const split = (v?: string) => (v || "").split("|").filter(Boolean);
		const UP = split(hero.dataset.up), DOWN = split(hero.dataset.down), COLORS = split(hero.dataset.colors);

		/* the drawing's frame and the landmarks bridge.py drew its outline on (2016 × 1344) */
		const VB_W = 2016, VB_H = 1344;
		const LEFT_OUT = 0.135, RIGHT_IN = 0.8185; /* Portugalete's outer leg, Las Arenas' inner leg */
		const TOP_V = 0.29, CROP_V = 0.8;        /* the tower tops; the plate's crop under the tug */
		const GX0 = 336, GX1 = 1692;
		const chordTop = (x: number) => 545 - (x - 420) * 0.017;
		const chordBot = (x: number) => 590 - (x - 420) * 0.016;

		/* the outline, sampled once into points every 6 units of its own frame: the structure (towers,
		   girder, car, plinths) apart from the lines (cables, hangers, stays), because only the lines may
		   pass behind the quotation (founder, 2026-10-02: "aunque haya un pelín de solapamiento con la
		   quote, no molesta") */
		const sample = (d = "") => {
			const out: [number, number][] = [];
			let cx = 0, cy = 0;
			for (const m of d.matchAll(/([ML])\s*(-?[\d.]+),(-?[\d.]+)/g)) {
				const x = +m[2], y = +m[3];
				if (m[1] === "L") {
					const n = Math.max(1, Math.ceil(Math.hypot(x - cx, y - cy) / 6));
					for (let i = 0; i <= n; i++) out.push([cx + ((x - cx) * i) / n, cy + ((y - cy) * i) / n]);
				}
				cx = x; cy = y;
			}
			return out;
		};
		const hardPts = sample(hero.dataset.hard);
		const softPts = sample(hero.dataset.soft);
		const pts = [...hardPts, ...softPts];

		/* every coordinate below is in the stage's own pixels, measured in the same task as what it is
		   compared with: a scroll between two tasks (a reload restores the scroll after the first layout)
		   moves every viewport rectangle and left the connectors hanging off the girder (founder, 2026-10-02) */
		type Box = { l: number; t: number; r: number; b: number; quote?: boolean };
		type Geo = { L: number; T: number; W: number; H: number };
		type Plug = { el: HTMLElement; foot: [number, number]; mid: [number, number]; end: [number, number] };
		let geo: Geo = { L: 0, T: 0, W: 0, H: 0 };
		let plugs: Plug[] = [];

		const toStage = (x: number, y: number, g: Geo): [number, number] => [g.L + (x / VB_W) * g.W, g.T + (y / VB_H) * g.H];
		const inside = (x: number, y: number, q: Box) => x > q.l && x < q.r && y > q.t && y < q.b;
		/* one comparison per line: the cms-text lint reads `> … <` on one line as a text node */
		function within(a: Box, room: Box): boolean {
			if (a.l <= room.l) return false;
			if (a.r >= room.r) return false;
			if (a.t <= room.t) return false;
			return a.b < room.b;
		}
		const overlap = (a: Box, b: Box, pad = 0) => a.l < b.r + pad && b.l - pad < a.r && a.t < b.b + pad && b.t - pad < a.b;
		const placed = (g: Geo, from: [number, number][] = pts) => from.map(([x, y]) => toStage(x, y, g));
		/* does any stroke pass through one of these boxes? */
		function strokesIn(boxes: Box[], onStage: [number, number][]): boolean {
			for (const [x, y] of onStage) for (const q of boxes) if (inside(x, y, q)) return true;
			return false;
		}
		/* the least drop that clears every box: moving the frame down only translates the points, so each
		   point under a box forbids one interval of drops — sort them and take the first gap */
		function leastDrop(pairs: [Box[], [number, number][]][]): number {
			const bad: [number, number][] = [];
			for (const [boxes, onStage] of pairs) for (const [x, y] of onStage) for (const q of boxes) {
				if (x <= q.l) continue;
				if (x >= q.r) continue;
				bad.push([q.t - y, q.b - y]);
			}
			bad.sort((u, v) => u[0] - v[0]);
			let d = 0;
			for (const [lo, hi] of bad) {
				if (hi <= d) continue;
				if (lo >= d) break;
				d = hi;
			}
			return d;
		}
		/* every line of the copy, padded, in the stage's pixels: nothing of the bridge may touch a letter */
		function textBoxes(s: DOMRect): Box[] {
			const out: Box[] = [];
			const pad = (q: DOMRect, quote = false): Box => ({ l: q.left - s.left - 12, r: q.right - s.left + 12, t: q.top - s.top - 12, b: q.bottom - s.top + 14, quote });
			for (const el of copy.querySelectorAll<HTMLElement>("h1, .s-hero__body p, .s-hero__epigraph p, .s-hero__epigraph figcaption")) {
				const r = document.createRange();
				r.selectNodeContents(el);
				const quote = !!el.closest(".s-hero__epigraph");
				for (const q of r.getClientRects()) if (q.width > 2) out.push(pad(q, quote));
			}
			const b = copy.querySelector<HTMLElement>(".btn")?.getBoundingClientRect();
			if (b) out.push(pad(b));
			return out;
		}
		function setGeo(g: Geo) {
			geo = g;
			hero.style.setProperty("--bx", `${g.L}px`);
			hero.style.setProperty("--by", `${g.T}px`);
			hero.style.setProperty("--bw", `${g.W}px`);
		}

		/* desktops: the Las Arenas tower just past the column, the scene two thirds of the
		   column-and-margin it could span, as high as the letters allow, the tug inside the band */
		function fitWide() {
			const s = stage.getBoundingClientRect();
			const text = textBoxes(s);
			const cs = getComputedStyle(inner), ib = inner.getBoundingClientRect();
			const colL = ib.left - s.left + parseFloat(cs.paddingLeft), colR = ib.right - s.left - parseFloat(cs.paddingRight);
			/* the bridge lives under the body text: it rises until it meets the quotation, never above */
			const body = copy.querySelector(".s-hero__body") || copy.querySelector("h1");
			const bodyBottom = body ? body.getBoundingClientRect().bottom - s.top : 0;
			const others = text.filter((q) => !q.quote);
			let W = (0.66 * (colR + 10 - (colL - 34))) / (RIGHT_IN - LEFT_OUT);
			for (let tries = 0; tries < 12; tries++) {
				const H = W / 1.5;
				/* as high as it goes: the tower tops just under the body's last line, then the least drop that
				   keeps the structure off every letter and the lines off every letter but the quotation's */
				const g = { L: colR + 10 - RIGHT_IN * W, T: bodyBottom + 4 - TOP_V * H, W, H };
				g.T += Math.ceil(leastDrop([[text, placed(g, hardPts)], [others, placed(g, softPts)]]));
				setGeo(g);
				if (g.T + CROP_V * H <= s.height - 4) return;
				W *= 0.94;
			}
		}
		/* phones: the scene is its own row under the copy, a little wider than the screen */
		function fitNarrow() {
			const s = stage.getBoundingClientRect();
			const W = s.width / 0.8, H = W / 1.5;
			setGeo({ L: -0.1 * W, T: s.height * 0.5 - 0.41 * H, W, H });
		}

		/* the connectors: a stem off the girder, a circle, a name — the protocols above, the platforms and
		   services below (founder, 2026-10-02: "protocolos arriba"), two heights each side, staggered so
		   neighbours can stand closer. Names are measured on a canvas in the bus's own font, so trying a
		   place costs no layout; only the ones that fit are written into the page, in one pass */
		const ruler = document.createElement("canvas").getContext("2d")!;
		function placePlugs(narrow: boolean) {
			bus.replaceChildren();
			plugs = [];
			const s = stage.getBoundingClientRect();
			const text = narrow ? [] : textBoxes(s);
			const room: Box = narrow ? { l: 4, t: 4, r: s.width - 4, b: s.height - 4 } : { l: 8, t: 84, r: s.width - 8, b: s.height - 10 };
			const size = narrow ? 11 : 12.5;
			ruler.font = `500 ${size}px ${getComputedStyle(bus).fontFamily}`;
			const taken: Box[] = [];
			const drawn = placed(geo), structure = placed(geo, hardPts);
			const out = document.createDocumentFragment();
			for (const [up, names] of [[true, UP], [false, DOWN]] as [boolean, string[]][]) {
				/* a phone shows at most four a side: the row is short and the names would crowd the drawing */
				const most = narrow ? Math.min(4, names.length) : names.length;
				/* a phone spreads its few along the girder, those below between those above; a desktop packs
				   them, because more fit */
				let i = 0;
				for (let k = 0; k <= 40 && i < most; k++) {
					if (narrow && k < Math.round(((i + (up ? 0 : 0.5)) * 40) / most)) continue;
					const gx = GX0 + ((GX1 - GX0) * k) / 40;
					const [fx, fy] = toStage(gx, up ? chordTop(gx) : chordBot(gx), geo);
					if (fx < room.l + 30 || fx > room.r - 30) continue;
					const w = ruler.measureText(names[i]).width + 0.02 * size * names[i].length;
					for (const h of i % 2 ? [92, 40] : [40, 92]) {
						const nameTop = up ? fy - h - 18 - size : fy + h + 18;
						const label: Box = { l: fx - w / 2 - 4, r: fx + w / 2 + 4, t: nameTop - 3, b: nameTop + size + 3 };
						const stem: Box = { l: fx - 6, r: fx + 6, t: up ? fy - h - 12 : fy + 6, b: up ? fy - 6 : fy + h + 12 };
						const clear = within(label, room) &&
							!text.some((q) => overlap(label, q, 26) || overlap(stem, q)) &&
							!taken.some((q) => overlap(label, q, 10) || overlap(stem, q, 4)) &&
							!strokesIn([label], drawn) &&
							(up || !strokesIn([stem], structure));
						if (!clear) continue;
						const el = document.createElement("div");
						el.className = `bridge__plug bridge__plug--${up ? "up" : "down"}`;
						el.style.left = `${fx}px`;
						el.style.top = `${up ? fy - h : fy}px`;
						el.style.height = `${h}px`;
						const name = document.createElement("span");
						name.textContent = names[i];
						el.appendChild(name);
						out.appendChild(el);
						taken.push(label, stem);
						const [, my] = toStage(gx, (chordTop(gx) + chordBot(gx)) / 2, geo);
						plugs.push({ el, foot: [fx, fy], mid: [fx, my], end: [fx, up ? fy - h - 6 : fy + h + 6] });
						i++;
						break;
					}
				}
			}
			bus.appendChild(out);
		}

		/* the frame first, so the banks can paint; the connectors in a task of their own */
		function layout() {
			const narrow = matchMedia("(max-width: 767px)").matches;
			if (narrow) fitNarrow(); else fitWide();
			hero.classList.add("is-placed");
			window.setTimeout(() => {
				placePlugs(narrow);
				if (reduced) still();
			}, 0);
		}

		/* messages: a ball from one connector to the girder's middle, along it and out to one or several
		   others, in one of the six verticals' colours */
		let feed: number | null = null;
		function send() {
			if (plugs.length < 2 || bus.querySelectorAll(".bridge__msg").length > 9) return;
			const from = plugs[Math.floor(Math.random() * plugs.length)];
			const others = plugs.filter((p) => p !== from).sort(() => Math.random() - 0.5);
			const fan = Math.random() < 0.3 ? Math.min(3, others.length) : 1;
			const color = COLORS[Math.floor(Math.random() * COLORS.length)] ?? "";
			for (const to of others.slice(0, fan)) {
				const route = [from.end, from.foot, from.mid, to.mid, to.foot, to.end];
				const d = [0, ...route.slice(1).map((p, k) => Math.hypot(p[0] - route[k][0], p[1] - route[k][1]))];
				const total = d.reduce((a, b) => a + b, 0) || 1;
				let acc = 0;
				const frames = route.map((p, k) => { acc += d[k]; return { transform: `translate(${p[0]}px, ${p[1]}px)`, offset: acc / total }; });
				const ball = document.createElement("i");
				ball.className = "bridge__msg";
				ball.style.setProperty("--msg", color);
				bus.appendChild(ball);
				const run = ball.animate(frames, { duration: total / 0.24, easing: "linear" });
				run.onfinish = () => {
					ball.remove();
					to.el.style.setProperty("--msg", color);
					to.el.classList.add("is-hit");
					window.setTimeout(() => to.el.classList.remove("is-hit"), 420);
				};
			}
		}
		/* reduced motion: the same picture, held — three messages standing on the girder */
		function still() {
			[0.25, 0.5, 0.75].forEach((t, k) => {
				const x = GX0 + (GX1 - GX0) * t;
				const [px, py] = toStage(x, (chordTop(x) + chordBot(x)) / 2, geo);
				const ball = document.createElement("i");
				ball.className = "bridge__msg";
				ball.style.setProperty("--msg", COLORS[(k * 2) % Math.max(1, COLORS.length)] ?? "");
				ball.style.transform = `translate(${px}px, ${py}px)`;
				bus.appendChild(ball);
			});
		}
		function startFeed() { if (feed !== null || reduced || pause.checked || document.hidden || !hero.classList.contains("is-done")) return; feed = window.setInterval(send, 700); send(); }
		function stopFeed() { if (feed !== null) { clearInterval(feed); feed = null; } }
		function freezeFeed(on: boolean) { for (const a of bus.getAnimations({ subtree: true })) on ? a.pause() : a.play(); }

		/* the sequence: the banks alone · the bridge, whole (CSS, 1.2 s → 2.1 s) · every connector at once ·
		   the messages (founder, 2026-10-02: "que el puente aparezca de una sola vez, y los conectores también") */
		let timer: number | null = null;
		function finish() {
			if (timer !== null) clearTimeout(timer);
			timer = null;
			hero.classList.remove("is-playing");
			hero.classList.add("is-done");
			startFeed();
		}
		function play() {
			hero.classList.add("is-playing");
			timer = window.setTimeout(finish, 2500);
		}

		let settling: number | null = null;
		window.addEventListener("resize", () => { if (settling !== null) clearTimeout(settling); settling = window.setTimeout(layout, 150); });
		/* once: after the faces are in, so the copy's lines and the names are measured as they render */
		if (document.fonts.status === "loaded") layout(); else document.fonts.ready.then(layout);
		if (reduced) {
			hero.classList.add("is-done");
		} else {
			const img = hero.querySelector<HTMLImageElement>(".bridge__banks")!;
			if (img.complete) play(); else img.addEventListener("load", play, { once: true });
		}
		/* pausing during the opening ends it at once: what stops is the motion, not the picture */
		pause.addEventListener("change", () => {
			hero.classList.toggle("is-paused", pause.checked);
			if (pause.checked) { if (hero.classList.contains("is-playing")) finish(); stopFeed(); freezeFeed(true); }
			else { freezeFeed(false); startFeed(); }
		});
		document.addEventListener("visibilitychange", () => { if (document.hidden) stopFeed(); else startFeed(); });
		replay.addEventListener("click", () => {
			if (reduced) return;
			stopFeed();
			if (timer !== null) clearTimeout(timer);
			bus.querySelectorAll(".bridge__msg").forEach((b) => b.remove());
			plugs.forEach((p) => p.el.classList.remove("is-hit"));
			pause.checked = false;
			hero.classList.remove("is-paused", "is-done", "is-playing");
			void hero.offsetWidth; /* a reflow between removing and re-adding the class, or the animations never restart */
			play();
		});
	}
</script>
