---
/**
 * HeroDie — the mark, tumbling beside the six plates (#517).
 *
 * The hero's through-line. The six drawings each compose a cube of their own,
 * but at six different places and six different sizes, so nothing carried the
 * eye from one to the next: the object the band is named after was the one
 * thing that jumped. This is that object, made real — the same die the menu
 * carries — tumbling down the margin beside the plates and back up it, one
 * quarter turn per slide, bringing that vertical's face to the front of the
 * isometric view.
 *
 * It is NOT LogoDie. That one is the logo: two rounded plates behind it, a
 * global script, an id, and a grey resting state that wakes one face at a time
 * from a menu hover. Here there is no logo to be, nothing to hover, and all
 * six faces are lit at once — six disciplines on one object is the whole
 * point. What the two share is the drawing, and the drawing is 20 lines.
 *
 * The choreography lives in homepage.css with the rest of the band's timing
 * (generated by docs/design/hero-rotativo/dado.py); what is here is the die
 * itself. Same split as LogoDie, and the same reason: a palette change must
 * not be able to repaint the brand, so the mark's own colours are fenced.
 *
 * Decorative (aria-hidden): the card underneath names the vertical, and the
 * dots say which of the six is showing. This adds no information.
 */
import { DIE_FACE, ICON_BY_KEY } from "../utils/nav";

interface Props {
	/** the six slides, in FACE_ORDER, each with its face key and its colour */
	faces: { face: string; color: string }[];
}
const { faces } = Astro.props;
---

<div class="s-hero__die" aria-hidden="true">
	<div class="s-hero__die-scale">
		<div class="s-hero__die-cube">
			{faces.map((f) => (
				<div class={`s-hero__die-face hd-${DIE_FACE[f.face as keyof typeof DIE_FACE]}`} style={`--fc:${f.color}`}>
					<svg class="hd-svg" viewBox="0 0 133 133">
						<polygon class="hd-slab" points="4.5,0 128.5,0 131,2 133,4.5 133,128.5 131,131 128.5,133 4.5,133 2,131 0,128.5 0,4.5 2,2"></polygon>
						<rect class="hd-cell" x="9" y="9" width="53" height="53"></rect>
						<rect class="hd-cell" x="71" y="9" width="53" height="53"></rect>
						<rect class="hd-cell" x="9" y="71" width="53" height="53"></rect>
						<rect class="hd-cell" x="71" y="71" width="53" height="53"></rect>
					</svg>
					<span class="hd-coin">
						{f.face === "ia" ? (
							<svg viewBox="0 0 24 24"><text x="12" y="16.5" text-anchor="middle" font-size="11.5" font-weight="700" fill="#fff">AI</text></svg>
						) : (
							<svg viewBox="0 0 24 24"><path d={ICON_BY_KEY[f.face as keyof typeof ICON_BY_KEY]}></path></svg>
						)}
					</span>
				</div>
			))}
		</div>
	</div>
</div>

<style is:global>
	/* ═══ HeroDie — the die itself. Its tumble is in homepage.css ═══ */

	/* Every length here is a multiple of `--die-l`, the cube's side, which
	   homepage.css clamps to the room the margin and the band actually have.
	   At its cap it is 124, which projects √2 × 124 = 175 px in isometric —
	   the size the menu shows the mark at, and the answer to the first draft
	   of this idea, where the die was matched to each drawing's cube and came
	   out at 590 px (founder: "no crees que el dado es enorme???"). It is the
	   mark, so it is mark-sized. The side is also the length of every relay,
	   because a die that covers one of its own widths per quarter turn is a
	   die that is rolling rather than sliding, and tying both to one number is
	   what keeps that true after the clamp bites. It is the same size in all
	   six slides, which is what the moving plates could not manage.

	   The fallback is on every reference because the variable is declared in
	   another file (#462): without one, a `--die-l` that failed to arrive
	   would not make the die small, it would drop the whole declaration and
	   leave a flat square where the mark should be. */
	.s-hero__die-scale {
		position: absolute;
		left: calc(var(--die-l, 124px) / -2);
		top: calc(var(--die-l, 124px) / -2);
		width: var(--die-l, 124px);
		height: var(--die-l, 124px);
	}
	.s-hero__die-cube {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
	}
	.s-hero__die-face {
		position: absolute;
		inset: 0;
		backface-visibility: hidden;
	}
	/* 4.5 and 133 against a side of 124 — the overhang scales with the rest,
	   or the chamfer stops meeting the silhouette once the clamp bites. */
	.s-hero__die .hd-svg {
		position: absolute;
		left: calc(var(--die-l, 124px) * -0.03629);
		top: calc(var(--die-l, 124px) * -0.03629);
		width: calc(var(--die-l, 124px) * 1.07258);
		height: calc(var(--die-l, 124px) * 1.07258);
	}
	/* The slab reaches half a line past the face and each corner is a pointed
	   chamfer, so every projected silhouette vertex closes in a clean point on
	   a GPU compositor. Copied from LogoDie deliberately: it is one drawing. */
	.s-hero__die .hd-slab {
		fill: var(--color-primary);
	}
	/* token-guard: off — the mark's own drawing. These colours belong to the
	   logo, not to the theme: a token here would let a palette change repaint
	   the brand. Same fence, same reason, as LogoDie.astro. */
	.s-hero__die .hd-cell {
		fill: var(--fc, #ced4da);
	}
	.s-hero__die .hd-coin {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 62%;
		height: 62%;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.75);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.s-hero__die .hd-coin svg {
		width: 62%;
		height: 62%;
		stroke: #fff;
		fill: none;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* token-guard: on */
	.s-hero__die .hd-coin text {
		stroke: none;
		font-family: var(--font-family-mono);
	}
	.s-hero__die .hd-front { transform: rotateY(0deg) translateZ(calc(var(--die-l, 124px) / 2)); }
	.s-hero__die .hd-right { transform: rotateY(90deg) translateZ(calc(var(--die-l, 124px) / 2)); }
	.s-hero__die .hd-back { transform: rotateY(180deg) translateZ(calc(var(--die-l, 124px) / 2)); }
	.s-hero__die .hd-left { transform: rotateY(-90deg) translateZ(calc(var(--die-l, 124px) / 2)); }
	.s-hero__die .hd-top { transform: rotateX(90deg) translateZ(calc(var(--die-l, 124px) / 2)); }
	.s-hero__die .hd-bottom { transform: rotateX(-90deg) translateZ(calc(var(--die-l, 124px) / 2)); }
</style>
