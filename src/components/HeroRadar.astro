---
/**
 * HeroRadar — the opening of the edge-security vertical (#529).
 *
 * A photograph of the Cabo Peñas lighthouse, cut out to the building, turns
 * into a line drawing of the same building, and a radar screen settles behind
 * it: range rings read from the origin outwards (ORIGIN · CDN · WAF · ACCESS ·
 * ZERO TRUST), a sweep at 12 rpm, a stream of edge events, and the visitor as
 * one echo. The lighthouse stands at the edge and lights what approaches — the
 * counter-image of the castle-and-moat perimeter the quotation describes.
 *
 * The band is dark but not black (founder, 2026-10-01: "un negro menos negro"):
 * a warm grey that drifts toward the photograph's own tone as it nears it,
 * with the logo cube as a seal in the section's colour. The copy keeps the
 * column and the register of every other hero; the drawing sits past the
 * column's right edge so no line of text ever touches it, in either phase.
 *
 * Two rules the review fixed: every piece of text is HTML at a fixed size
 * positioned in percentages of the frame, never text inside the scaled SVG;
 * and the sweep is a composited element (a rotated conic gradient), never a
 * transform on an SVG group, which re-lays the whole drawing out every frame.
 *
 * Copy is the service page's own: title, excerpt, CTA and the epigraph — the
 * blockquote the CMS content opens with, whose linked span names the author
 * and carries the source. Chrome strings come from the `panel_labels` widget,
 * English in both locales — a machine voice, like the PR card.
 */
import { HERO_RADAR, HERO_RADAR_SIZES } from "../utils/hero-art";

interface Props {
	title: string;
	excerptHtml: string;
	ctaLabel: string;
	contactPath: string;
	quote: any[] | null;
	labels: { get: (widget: string, key: string, fallback: string) => string };
}
const { title, excerptHtml, ctaLabel, contactPath, quote, labels } = Astro.props;
const L = (k: string, fb: string) => labels.get("panel_labels", k, fb);

const rings = L("radar_rings", "ORIGIN,CDN,WAF,ACCESS,ZERO TRUST").split(",");
const range = L("radar_range", "35 nm · nominal range");
const you = L("radar_you", "you");
const events = L("radar_events", "").split(";").map((e) => e.trim()).filter(Boolean);
const pauseLabel = L("radar_pause", "Pausar el radar");
const replayLabel = L("radar_replay", "Repetir la animación");

/* The epigraph: the quotation is the plain spans of the opening blockquote;
   the author is its one linked span, and the link is the source. */
interface Span { text: string; marks?: string[] }
interface MarkDef { _key: string; href?: string }
const block = quote?.[0] ?? null;
const spans: Span[] = block?.children ?? [];
const defs: MarkDef[] = block?.markDefs ?? [];
const sourceOf = (s: Span): string => defs.find((d) => d.href && (s.marks ?? []).includes(d._key))?.href ?? "";
const quoteText = spans.filter((s) => !sourceOf(s)).map((s) => s.text).join("").trim();
const author = spans.find((s) => sourceOf(s)) ?? null;

/* Where each ring label sits, in % of the 1205.5 × 1384 frame the drawing was
   solved in: the origin at the tower base, the four rings where the 70°
   bearing crosses them, in open sky left of the tower, nearest the copy. */
const RING_POS: [number, number][] = [
	[72.2, 91.2],
	[41.97, 27.31],
	[36.91, 15.1],
	[31.77, 2.89],
	[26.71, -9.32],
];
---

<section class="s-hero s-hero--radar" aria-label={title} data-events={JSON.stringify(events)}>
	<div class="s-hero__stage radar" aria-hidden="true">
		<div class="radar__box radar__screen">
			{/* rings every 180 units from the tower base at (777.5, 1063); the dashed one is the light's nominal range, 35 nautical miles (es.wikipedia, Faro de Cabo Peñas) */}
			<svg viewBox="0 0 1205.5 1384" preserveAspectRatio="xMidYMid meet">
				<g class="radar__rings" fill="none">
					{[180, 360, 540, 720, 900, 1080, 1260, 1440].map((r) => <circle cx="777.5" cy="1063" r={r} />)}
					<line x1="-1500" y1="1063" x2="3000" y2="1063" /><line x1="777.5" y1="-600" x2="777.5" y2="2700" />
					<line x1="-355" y1="-70" x2="1910" y2="2196" /><line x1="1910" y1="-70" x2="-355" y2="2196" />
				</g>
				<circle class="radar__range-ring" cx="777.5" cy="1063" r="630" fill="none" stroke-dasharray="10 8" />
				<g class="radar__scale" fill="none">
					<line x1="777.5" y1="1063" x2="300" y2="-250" />
					<line x1="520" y1="382" x2="542" y2="390" /><line x1="459" y1="213" x2="481" y2="221" /><line x1="397" y1="44" x2="419" y2="52" /><line x1="336" y1="-125" x2="358" y2="-117" />
				</g>
			</svg>
			<div class="radar__sweep"></div>
		</div>
		<div class="radar__box radar__art">
			<img class="radar__photo" src={HERO_RADAR.photo} srcset={`${HERO_RADAR.photoSmall} 720w, ${HERO_RADAR.photo} 1320w`} sizes={HERO_RADAR_SIZES} width="1320" height="1515" alt="" fetchpriority="high" decoding="async" />
			<img class="radar__plan" src={HERO_RADAR.plan} srcset={`${HERO_RADAR.planSmall} 660w, ${HERO_RADAR.plan} 1210w`} sizes={HERO_RADAR_SIZES} width="1210" height="1392" alt="" fetchpriority="low" decoding="async" />
		</div>
		<span class="s-hero__scrim"></span>
		<div class="radar__box radar__hud">
			{rings.map((r, i) => (
				<span class={i === 0 ? "radar__origin" : "radar__lab"} style={`left:${RING_POS[i]?.[0] ?? 0}%;top:${RING_POS[i]?.[1] ?? 0}%`}>{r}</span>
			))}
			<span class="radar__range">{range}</span>
			<span class="radar__you" data-volatile hidden><b>{you}</b><span class="radar__ip"></span></span>
			<div class="radar__feed" data-volatile></div>
		</div>
	</div>
	{/* the seal: the logo cube's outline and inner edges (CubeEmblem.astro draws the same path), one, large, in the section's colour */}
	<svg class="radar__seal" viewBox="0 0 200 228" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z M14,64 100,114 186,64 M100,114 100,214" /></svg>
	<div class="container s-hero__inner">
		<div class="s-hero__copy">
			<h1>{title}</h1>
			{excerptHtml && (
				<div class="s-hero__body">
					<p class="text-body" set:html={excerptHtml} />
				</div>
			)}
			<a href={contactPath} class="btn btn-light">{ctaLabel}</a>
			{quoteText && (
				<figure class="s-hero__epigraph">
					<blockquote><p>{quoteText}</p></blockquote>
					{author && (
						<figcaption>— <a href={sourceOf(author)} target="_blank" rel="noopener noreferrer">{author.text}</a></figcaption>
					)}
				</figure>
			)}
		</div>
	</div>
	{/* WCAG 2.2.2: one control stops the sweep, the pulse and the event stream; the other replays the
	    sequence from the photograph. Faded on desktops until the band is hovered or a control has focus;
	    always visible where there is no hover (founder, 2026-10-01: "piensa en el mobile") */}
	<div class="radar__ctl">
		<button type="button" class="radar__replay" aria-label={replayLabel}></button>
		<input type="checkbox" id="radar-pause" class="radar__pause" aria-label={pauseLabel} />
		<label for="radar-pause" class="radar__pause-btn" aria-hidden="true"></label>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>(".s-hero--radar");
	if (hero) {
		const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const narrow = matchMedia("(max-width: 767px)").matches;
		const feed = hero.querySelector<HTMLElement>(".radar__feed")!;
		const pause = hero.querySelector<HTMLInputElement>(".radar__pause")!;
		const EVENTS: string[] = JSON.parse(hero.dataset.events || "[]");
		/* candidate zones in % of the frame, and the side each label reads to; a candidate is then
		   checked against the page — never over the copy, the building, the ring labels, the visitor's
		   echo or past the band's edge — because the frame sits differently at every viewport */
		const ZONES: [number, number, number, number, boolean][] = narrow
			? [[2, 6, 86, 92, false], [40, 50, 2, 8, false]]
			: [[10, 60, -14, 12, false], [60, 86, -14, 12, true], [-40, 10, 14, 58, false], [78, 92, 14, 56, false], [-40, 12, 62, 90, false]];
		/* the building, in % of the frame: the tower and the house */
		const BUILDING: [number, number, number, number] = [18, 92, 20, 104];
		const hud = hero.querySelector<HTMLElement>(".radar__hud")!;
		const copy = hero.querySelector<HTMLElement>(".s-hero__copy")!;
		const youEl = hero.querySelector<HTMLElement>(".radar__you");
		function clear(x: number, y: number, left: boolean, text: string): boolean {
			const f = hud.getBoundingClientRect();
			const band = hero.getBoundingClientRect();
			const w = text.length * 7.6 + 22, h = 16;
			const px = f.left + (x / 100) * f.width, py = f.top + (y / 100) * f.height;
			const r = { left: left ? px - w : px, top: py - h / 2, right: left ? px : px + w, bottom: py + h / 2 };
			/* one comparison per line: the cms-text lint reads `> … <` on one line as a text node */
			const hits = (b: { left: number; top: number; right: number; bottom: number }, pad: number) =>
				r.left < b.right + pad &&
				b.left - pad < r.right &&
				r.top < b.bottom + pad &&
				b.top - pad < r.bottom;
			if (r.left < band.left + 8 || r.right > band.right - 8 || r.top < band.top + 8 || r.bottom > band.bottom - 8) return false;
			if (!narrow && hits(copy.getBoundingClientRect(), 14)) return false;
			if (youEl && !youEl.hidden && hits(youEl.getBoundingClientRect(), 10)) return false;
			if (BUILDING[0] < x && x < BUILDING[1] && BUILDING[2] < y && y < BUILDING[3]) return false;
			for (const el of hud.querySelectorAll<HTMLElement>(".radar__lab, .radar__origin, .radar__range")) if (hits(el.getBoundingClientRect(), 8)) return false;
			return true;
		}
		const live: [number, number][] = [];
		let timer: number | null = null;
		let k = 0;

		function place(x: number, y: number, left: boolean, text: string) {
			const d = document.createElement("span");
			d.className = "radar__blip" + (left ? " radar__blip--l" : "");
			d.style.left = `${x}%`;
			d.style.top = `${y}%`;
			d.textContent = text;
			feed.appendChild(d);
			return d;
		}
		function blip() {
			let x = 0, y = 0, z = ZONES[0], tries = 0;
			/* a plain function, not an arrow: the cms-text lint reads `=> … <` on one line as a text node */
			function near(q: [number, number]): boolean { return Math.abs(q[1] - y) < 6 && Math.abs(q[0] - x) < 34; }
			const text = EVENTS[k % EVENTS.length];
			do {
				z = ZONES[Math.floor(Math.random() * ZONES.length)];
				x = z[0] + Math.random() * (z[1] - z[0]);
				y = z[2] + Math.random() * (z[3] - z[2]);
			} while (++tries < 40 && (live.some(near) || !clear(x, y, z[4], text)));
			if (tries >= 40 || EVENTS.length === 0) return;
			k += 1;
			const me: [number, number] = [x, y];
			live.push(me);
			const d = place(x, y, z[4], text);
			setTimeout(() => { d.remove(); live.splice(live.indexOf(me), 1); }, 2400);
		}
		/* a ring label that lands on the copy is withheld: the frame is placed by the column, but at
		   narrower desktops the rings' upper labels still reach into it */
		function settleLabels() {
			if (narrow) return;
			const c = copy.getBoundingClientRect();
			for (const el of hud.querySelectorAll<HTMLElement>(".radar__lab, .radar__origin, .radar__range")) {
				el.style.visibility = "";
				const r = el.getBoundingClientRect();
				const apart = r.right < c.left - 10 || c.right + 10 < r.left || r.bottom < c.top - 10 || c.bottom + 10 < r.top;
				if (!apart) el.style.visibility = "hidden";
			}
		}
		settleLabels();
		let settling: number | null = null;
		window.addEventListener("resize", () => { if (settling !== null) clearTimeout(settling); settling = window.setTimeout(settleLabels, 150); });
		function startFeed() { if (timer !== null || reduced || pause.checked || document.hidden) return; timer = window.setInterval(blip, 520); blip(); }
		function stopFeed() { if (timer !== null) { clearInterval(timer); timer = null; } }
		function done() { hero.classList.add("is-done"); window.setTimeout(startFeed, 200); }

		pause.addEventListener("change", () => { hero.classList.toggle("is-paused", pause.checked); if (pause.checked) stopFeed(); else if (hero.classList.contains("is-done")) startFeed(); });
		document.addEventListener("visibilitychange", () => { if (document.hidden) stopFeed(); else if (hero.classList.contains("is-done")) startFeed(); });

		const plan = hero.querySelector<HTMLImageElement>(".radar__plan")!;
		const replay = hero.querySelector<HTMLButtonElement>(".radar__replay")!;
		function play() {
			plan.addEventListener("animationend", done, { once: true });
			window.setTimeout(() => hero.classList.add("is-playing"), 300);
		}
		if (reduced) {
			/* the resting state at once, with one still event per zone */
			hero.classList.add("is-done");
			ZONES.forEach((z, i) => { const x = (z[0] + z[1]) / 2, y = (z[2] + z[3]) / 2; if (EVENTS[i] && clear(x, y, z[4], EVENTS[i])) place(x, y, z[4], EVENTS[i]); });
		} else {
			const imgs = Array.from(hero.querySelectorAll<HTMLImageElement>(".radar__art img"));
			let n = 0;
			const ready = () => { if (++n === imgs.length) play(); };
			imgs.forEach((im) => (im.complete ? ready() : im.addEventListener("load", ready, { once: true })));
		}
		/* replay: back to the photograph and through the sequence again; the pause is released, the feed cleared */
		replay.addEventListener("click", () => {
			if (reduced) return;
			stopFeed();
			feed.replaceChildren();
			live.length = 0;
			pause.checked = false;
			hero.classList.remove("is-paused", "is-done", "is-playing");
			void hero.offsetWidth; /* a reflow between removing and re-adding the class, or the animations never restart */
			play();
		});

		/* the visitor's echo: asked by the browser so the cached page never carries anyone's address; hidden unless the edge answers */
		const ipEl = hero.querySelector<HTMLElement>(".radar__ip");
		if (youEl && ipEl) {
			fetch("/api/whoami", { cache: "no-store" })
				.then((r) => (r.ok ? r.json() : null))
				.then((d: { ip?: string; city?: string } | null) => {
					if (!d || !d.ip) return;
					ipEl.textContent = d.city ? ` · ${d.ip} · ${d.city}` : ` · ${d.ip}`;
					youEl.hidden = false;
				})
				.catch(() => {});
		}
	}
</script>
