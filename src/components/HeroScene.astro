---
/**
 * HeroScene — the opening every vertical shares (#529, #531).
 *
 * One structure for all six (founder, 2026-10-01: "todas las páginas tienen
 * que tener una estructura común… el cubo de una página con respecto al de
 * otra tiene que estar en el mismo sitio, y la posición del H1 también"):
 * the dark band, the copy in the column at one reference height, the
 * epigraph, the seal cube, the veil and the two controls. A vertical brings
 * only its art, through two slots — `under` the veil and `over` it — and its
 * own script for what moves.
 *
 * Copy is the service page's own: title, excerpt, CTA and the epigraph — the
 * blockquotes the CMS content opens with, whose linked span names the author
 * and carries the source. With more than one, they take turns in one place
 * (#537: three of Martin Fowler's), stacked in one grid cell so the band never
 * changes height; the pause stops them, and reduced motion keeps the first.
 */
interface Props {
	scene: string;
	title: string;
	excerptHtml: string;
	ctaLabel: string;
	contactPath: string;
	quote: any[] | null;
	pauseLabel: string;
	replayLabel: string;
	data?: Record<string, string>;
}
const { scene, title, excerptHtml, ctaLabel, contactPath, quote, pauseLabel, replayLabel, data = {} } = Astro.props;

/* Each epigraph: the quotation is the plain spans of an opening blockquote;
   the author is its one linked span, and the link is the source. */
interface Span { text: string; marks?: string[] }
interface MarkDef { _key: string; href?: string }
interface Epigraph { text: string; author: string; href: string }
const epigraphs: Epigraph[] = (quote ?? []).map((block) => {
	const spans: Span[] = block?.children ?? [];
	const defs: MarkDef[] = block?.markDefs ?? [];
	const sourceOf = (s: Span): string => defs.find((d) => d.href && (s.marks ?? []).includes(d._key))?.href ?? "";
	const author = spans.find((s) => sourceOf(s));
	return { text: spans.filter((s) => !sourceOf(s)).map((s) => s.text).join("").trim(), author: author?.text ?? "", href: author ? sourceOf(author) : "" };
}).filter((e) => e.text);
const dataAttrs = Object.fromEntries(Object.entries(data).map(([k, v]) => [`data-${k}`, v]));
---

<section class:list={["s-hero", "s-hero--scene", `s-hero--${scene}`]} aria-label={title} {...dataAttrs}>
	<div class="s-hero__stage" aria-hidden="true">
		<slot name="under" />
		<span class="s-hero__scrim"></span>
		<slot name="over" />
	</div>
	{/* the seal: the logo cube's outline and inner edges (CubeEmblem.astro draws the same path), one, large, in the section's colour */}
	<svg class="scene__seal" viewBox="0 0 200 228" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z M14,64 100,114 186,64 M100,114 100,214" /></svg>
	<div class="container s-hero__inner">
		<div class="s-hero__copy">
			<h1>{title}</h1>
			{excerptHtml && (
				<div class="s-hero__body">
					<p class="text-body" set:html={excerptHtml} />
				</div>
			)}
			<a href={contactPath} class="btn btn-light">{ctaLabel}</a>
			{epigraphs.length > 0 && (
				<div class="s-hero__epigraphs">
					{epigraphs.map((e, i) => (
						<figure
							class:list={["s-hero__epigraph", i === 0 && "is-shown"]}
							aria-hidden={i === 0 ? undefined : "true"}
						>
							<blockquote><p>{e.text}</p></blockquote>
							{e.author && (
								<figcaption>— <a href={e.href} target="_blank" rel="noopener noreferrer" tabindex={i === 0 ? undefined : -1}>{e.author}</a></figcaption>
							)}
						</figure>
					))}
				</div>
			)}
		</div>
	</div>
	{/* WCAG 2.2.2: one control stops everything that moves, the other replays the sequence from the start.
	    Faded on desktops until the band is hovered or a control has focus; always visible where there is
	    no hover (founder, 2026-10-01: "piensa en el mobile") */}
	<div class="scene__ctl">
		<button type="button" class="scene__replay" aria-label={replayLabel}></button>
		<input type="checkbox" id={`${scene}-pause`} class="scene__pause" aria-label={pauseLabel} />
		<label for={`${scene}-pause`} class="scene__pause-btn" aria-hidden="true"></label>
	</div>
</section>

<script>
	/* the epigraphs take turns, one every 9 s, in every scene that has more than one; the pause and a
	   hidden tab stop them, the replay starts them again from the first */
	for (const hero of document.querySelectorAll<HTMLElement>(".s-hero--scene")) {
		const figs = [...hero.querySelectorAll<HTMLElement>(".s-hero__epigraph")];
		if (figs.length < 2 || matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
		const pause = hero.querySelector<HTMLInputElement>(".scene__pause");
		let shown = 0;
		let timer: number | null = null;
		const show = (n: number) => {
			shown = n;
			figs.forEach((f, k) => {
				f.classList.toggle("is-shown", k === n);
				if (k === n) f.removeAttribute("aria-hidden"); else f.setAttribute("aria-hidden", "true");
				const a = f.querySelector("a");
				if (a && k === n) a.removeAttribute("tabindex"); else if (a) a.setAttribute("tabindex", "-1");
			});
		};
		const stop = () => { if (timer !== null) { clearInterval(timer); timer = null; } };
		const run = () => {
			if (timer !== null || pause?.checked || document.hidden) return;
			timer = window.setInterval(() => show((shown + 1) % figs.length), 9000);
		};
		pause?.addEventListener("change", () => (pause.checked ? stop() : run()));
		document.addEventListener("visibilitychange", () => (document.hidden ? stop() : run()));
		/* the replay releases the pause itself: the scene's own handler may run after this one */
		hero.querySelector(".scene__replay")?.addEventListener("click", () => { stop(); if (pause) pause.checked = false; show(0); run(); });
		run();
	}
</script>
