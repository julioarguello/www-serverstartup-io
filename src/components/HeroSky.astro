---
/**
 * HeroSky — the opening of the Big Data vertical (#556).
 *
 * Three robotic-telescope domes at the Teide Observatory, the sea and an island on the horizon, told in four
 * beats (founder, 2026-10-05, story R):
 *
 * 1. the observatory by day;
 * 2. night falls, when telescopes work: the domes are drawn in line, a telescope's graticule (one degree
 *    apart) is drawn over the sky, and thousands of raw detections fill it — bronze;
 * 3. a test pass sweeps the sky: the noise (false detections, satellite trails) is flagged and dropped, and
 *    what passes is the catalogue — gold. The page's thesis: the data that fails its tests never reaches gold;
 * 4. day comes back; the drawing goes, the photograph stays.
 *
 * The band, the copy, the epigraphs, the seal, the veil and the controls are the scene every vertical
 * shares (HeroScene.astro). Everything is measured on the photograph (`teide.py`): the graticule is projected
 * through the camera fitted to the sea horizon, the domes are their own outlines, the detections are placed in
 * the same frame; the browser only plays them. At night the band IS the sky, so the drawing is played over the
 * veil on the whole stage, climbing above the photograph, and leaves a hole wherever the copy has a letter.
 */
import { HERO_SKY, HERO_SKY_SIZES } from "../utils/hero-art";
import HeroScene from "./HeroScene.astro";

interface Props {
	title: string;
	excerptHtml: string;
	ctaLabel: string;
	contactPath: string;
	quote: any[] | null;
	labels: { get: (widget: string, key: string, fallback: string) => string };
}
const { title, excerptHtml, ctaLabel, contactPath, quote, labels } = Astro.props;
const L = (k: string, fb: string) => labels.get("panel_labels", k, fb);
const pauseLabel = L("sky_pause", "Pausar la animación");
const replayLabel = L("sky_replay", "Repetir la animación");
---

<HeroScene scene="sky" title={title} excerptHtml={excerptHtml} ctaLabel={ctaLabel} contactPath={contactPath} quote={quote} pauseLabel={pauseLabel} replayLabel={replayLabel}>
	<div slot="under" class="sky__box">
		<img class="sky__photo" src={HERO_SKY.photo} srcset={`${HERO_SKY.photoSmall} 720w, ${HERO_SKY.photo} 1320w, ${HERO_SKY.photoLarge} 2016w`} sizes={HERO_SKY_SIZES} width="1320" height="642" alt="" fetchpriority="high" decoding="async" />
	</div>
	<canvas slot="over" class="sky__data" aria-hidden="true"></canvas>
	<i slot="over" class="sky__ink sky__ink--line" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--raw" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--gold" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--noise" aria-hidden="true"></i>
</HeroScene>

<script>
	import { SCENE_ROW, SCENE_BEATS } from "../utils/hero-art";
	import { SceneClock } from "../utils/scene-clock";
	import sky from "../assets/hero/bd-cielo.json";
	const hero = document.querySelector<HTMLElement>(".s-hero--sky");
	if (hero) {
		const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const stage = hero.querySelector<HTMLElement>(".s-hero__stage")!;
		const seal = hero.querySelector<SVGElement>(".scene__seal")!;
		const canvas = hero.querySelector<HTMLCanvasElement>(".sky__data")!;
		const ctx = canvas.getContext("2d")!;
		const pause = hero.querySelector<HTMLInputElement>(".scene__pause")!;
		const replay = hero.querySelector<HTMLButtonElement>(".scene__replay")!;

		const [FW, FH] = sky.frame;
		const ASPECT = FW / FH;                  /* the photograph's frame, its foreground cropped */
		const BAND_H = 0.86;                     /* the frame's height, of the band's */
		const BLEED = 0.02;                      /* how far past the band's edge the frame runs */
		const SEAL_R = 0.93;                     /* the seal's right vertex, of its width (186 of 200) */
		const SEA = sky.sea;                     /* the sea horizon's row: the sky ends there */
		type Geo = { L: number; T: number; W: number; H: number };
		type Box = { l: number; t: number; r: number; b: number };
		let geo: Geo = { L: 0, T: 0, W: 0, H: 0 };
		let holes: Box[] = [];
		let from = 0;                            /* where the drawing may start: past the seal on desktops */
		let dpr = 1;

		/* the colours are the stylesheet's (tokens), resolved through four hidden inks */
		function ink(k: string) {
			const el = hero!.querySelector(`.sky__ink--${k}`) as HTMLElement;
			return getComputedStyle(el).color;
		}
		let LINE = "", RAW = "", GOLD = "", NOISE = "";

		/* desktops: sized by the band, resting on its floor, running off its right edge like every scene */
		function fitWide(s: DOMRect): Geo {
			const sr = seal.getBoundingClientRect();
			from = sr.left - s.left + SEAL_R * sr.width + 8;
			const H = BAND_H * s.height, W = ASPECT * H;
			const L = s.width + BLEED * W - W;
			hero!.style.setProperty("--sclip", `${Math.max(0, from - L)}px`);
			return { L, T: s.height - H, W, H };
		}
		/* phones and tablets: the scene is its own row under the copy, contained in it, flush right */
		function fitNarrow(s: DOMRect): Geo {
			const W = Math.min(1.25 * s.width, ASPECT * s.height), H = W / ASPECT;
			from = 0;
			hero!.style.setProperty("--sclip", "0px");
			return { L: s.width - W * (1 - BLEED), T: (s.height - H) / 2, W, H };
		}
		/* every line of the copy, padded: the drawing never crosses a letter */
		function textBoxes(s: DOMRect): Box[] {
			const out: Box[] = [];
			const pad = (q: DOMRect): Box => ({ l: q.left - s.left - 14, r: q.right - s.left + 14, t: q.top - s.top - 10, b: q.bottom - s.top + 10 });
			for (const el of hero!.querySelectorAll<HTMLElement>(".s-hero__copy h1, .s-hero__body p, .s-hero__epigraph p, .s-hero__epigraph figcaption")) {
				const r = document.createRange();
				r.selectNodeContents(el);
				for (const q of r.getClientRects()) if (q.width > 2) out.push(pad(q));
			}
			const b = hero!.querySelector<HTMLElement>(".s-hero__copy .btn")?.getBoundingClientRect();
			if (b) out.push(pad(b));
			const c = hero!.querySelector<HTMLElement>(".scene__ctl")?.getBoundingClientRect();
			if (c) out.push(pad(c));
			return out;
		}
		function layout() {
			const s = stage.getBoundingClientRect();
			const narrow = matchMedia(SCENE_ROW).matches;
			geo = narrow ? fitNarrow(s) : fitWide(s);
			holes = narrow ? [] : textBoxes(s);
			hero!.style.setProperty("--sx", `${geo.L}px`);
			hero!.style.setProperty("--sy", `${geo.T}px`);
			hero!.style.setProperty("--sw", `${geo.W}px`);
			hero!.style.setProperty("--sfade-l", `${Math.round(0.14 * geo.W)}px`);
			hero!.style.setProperty("--sfade-b", narrow ? `${Math.round(0.12 * geo.H)}px` : "0px");
			dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.round(s.width * dpr);
			canvas.height = Math.round(s.height * dpr);
			LINE = ink("line"); RAW = ink("raw"); GOLD = ink("gold"); NOISE = ink("noise");
			hero!.classList.add("is-placed");
			draw(t);
		}

		/* the timeline, in ms from the start (SCENE_BEATS): the CSS plays night and day; this plays the drawing —
		   the lines from --beat-draw, the detections filling the sky until --beat-drawn, the test pass after it,
		   and everything goes as day comes back */
		const LINES_AT = SCENE_BEATS.draw + 200, LINE_MS = 700;
		const FILL_AT = SCENE_BEATS.draw + 600, FILL_MS = SCENE_BEATS.drawn - FILL_AT;
		const TRAILS_AT = FILL_AT + 900;
		const SWEEP_AT = SCENE_BEATS.drawn, SWEEP_MS = 1800;
		const FADE_AT = SWEEP_AT + SWEEP_MS + 200, FADE_MS = 1000;
		const FLAG_MS = 220, DROP_MS = 320, TURN_MS = 260;
		const FROM_FADE = 140;                  /* px over which the drawing fades in past the seal */
		const P = sky.pts, N = P.length / 4, TR = sky.trails;
		const clamp = (x: number) => Math.min(1, Math.max(0, x));
		/* when the sweep reaches column x, in ms from the start */
		const swept = (x: number) => SWEEP_AT + (SWEEP_MS * x) / FW;
		/* each line's cumulative length, so it can be drawn part of the way */
		const LENS = sky.lines.map((l) => {
			const c = [0];
			for (let i = 2; i < l.p.length; i += 2) c.push(c[c.length - 1] + Math.hypot(l.p[i] - l.p[i - 2], l.p[i + 1] - l.p[i - 1]));
			return c;
		});

		function strokePart(p: number[], c: number[], u: number) {
			const end = u * c[c.length - 1];
			ctx.beginPath();
			ctx.moveTo(p[0], p[1]);
			for (let i = 1; i < c.length; i++) {
				if (c[i] <= end) { ctx.lineTo(p[2 * i], p[2 * i + 1]); continue; }
				const f = (end - c[i - 1]) / (c[i] - c[i - 1]);
				ctx.lineTo(p[2 * i - 2] + f * (p[2 * i] - p[2 * i - 2]), p[2 * i - 1] + f * (p[2 * i + 1] - p[2 * i - 1]));
				break;
			}
			ctx.stroke();
		}

		let t = 0;
		function draw(ms: number) {
			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			if (ms < LINES_AT || ms >= FADE_AT + FADE_MS) return;
			ctx.save();
			/* the photograph's frame */
			const k = geo.W / FW;
			ctx.setTransform(dpr * k, 0, 0, dpr * k, dpr * geo.L, dpr * geo.T);
			const px = 1 / k;                    /* one CSS pixel, in frame units */
			const fade = 1 - clamp((ms - FADE_AT) / FADE_MS);
			ctx.lineJoin = "round";

			/* the graticule and the domes */
			ctx.strokeStyle = LINE;
			sky.lines.forEach((l, i) => {
				const u = clamp((ms - LINES_AT - l.d) / LINE_MS);
				if (u <= 0) return;
				ctx.globalAlpha = fade * (l.k === "alt" || l.k === "az" ? 0.4 : 0.85);
				ctx.lineWidth = (l.k === "alt" || l.k === "az" ? 1 : 1.75) * px;
				strokePart(l.p, LENS[i], u);
			});

			/* the detections: raw until the sweep reaches them; then the noise is flagged and dropped, and what
			   passes turns gold, a little larger */
			const R = [0.9 * px, 1.5 * px, 2.4 * px];
			for (let i = 0; i < N; i++) {
				const x = P[4 * i], y = P[4 * i + 1], r = R[P[4 * i + 2]], noise = P[4 * i + 3];
				const a = clamp((ms - FILL_AT - (FILL_MS * i) / N) / 200);
				if (a <= 0) continue;
				const since = ms - swept(x);
				if (since < 0) {
					ctx.globalAlpha = fade * a * 0.85;
					ctx.fillStyle = RAW;
					ctx.fillRect(x - r, y - r, 2 * r, 2 * r);
				} else if (noise) {
					const out = clamp((since - FLAG_MS) / DROP_MS);
					if (out >= 1) continue;
					ctx.globalAlpha = fade * (1 - out);
					ctx.strokeStyle = NOISE;
					ctx.lineWidth = 1.2 * px;
					ctx.beginPath();
					ctx.arc(x, y, r + 4 * px, 0, 2 * Math.PI);
					ctx.stroke();
				} else {
					const g = clamp(since / TURN_MS);
					if (g < 1) {
						ctx.globalAlpha = fade * 0.85 * (1 - g);
						ctx.fillStyle = RAW;
						ctx.fillRect(x - r, y - r, 2 * r, 2 * r);
					}
					ctx.globalAlpha = fade * g;
					ctx.fillStyle = GOLD;
					ctx.beginPath();
					ctx.arc(x, y, r * (1 + 0.35 * g), 0, 2 * Math.PI);
					ctx.fill();
				}
			}
			/* the satellite trails: raw streaks, flagged and dropped when the sweep reaches their middle */
			ctx.lineWidth = 1.4 * px;
			for (let i = 0; i < TR.length; i += 4) {
				const a = clamp((ms - TRAILS_AT - 150 * i) / 300);
				if (a <= 0) continue;
				const since = ms - swept((TR[i] + TR[i + 2]) / 2);
				const out = since < 0 ? 0 : clamp((since - FLAG_MS) / DROP_MS);
				if (out >= 1) continue;
				ctx.globalAlpha = fade * a * (1 - out);
				ctx.strokeStyle = since < 0 ? RAW : NOISE;
				ctx.beginPath();
				ctx.moveTo(TR[i], TR[i + 1]);
				ctx.lineTo(TR[i + 2], TR[i + 3]);
				ctx.stroke();
			}
			/* the test pass: a scan line across the sky, from the band's top to the sea horizon */
			if (Math.floor((ms - SWEEP_AT) / SWEEP_MS) === 0) {
				const x = (FW * (ms - SWEEP_AT)) / SWEEP_MS, top = -geo.T / k, band = 120 * px;
				const g = ctx.createLinearGradient(x - band, 0, x, 0);
				g.addColorStop(0, "rgba(0, 0, 0, 0)");
				g.addColorStop(1, LINE);
				ctx.globalAlpha = 0.3;
				ctx.fillStyle = g;
				ctx.fillRect(x - band, top, band, SEA - top);
				ctx.globalAlpha = 1;
				ctx.fillStyle = LINE;
				ctx.fillRect(x - px, top, 2 * px, SEA - top);
			}
			ctx.restore();
			/* then, on the stage: a hole for every line of the copy (erased, not clipped — the padded lines
			   overlap, and an even-odd clip paints their overlaps back), and a fade in from the seal */
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.globalCompositeOperation = "destination-out";
			ctx.globalAlpha = 1;
			ctx.fillStyle = "#000";               /* what is erased is the alpha: any opaque colour */
			for (const h of holes) ctx.fillRect(h.l, h.t, h.r - h.l, h.b - h.t);
			if (from > 0) {
				const g = ctx.createLinearGradient(from, 0, from + FROM_FADE, 0);
				g.addColorStop(0, "rgba(0, 0, 0, 1)");
				g.addColorStop(1, "rgba(0, 0, 0, 0)");
				ctx.fillStyle = g;
				ctx.fillRect(0, 0, from + FROM_FADE, canvas.height / dpr);
			}
			ctx.globalCompositeOperation = "source-over";
		}

		const clock = new SceneClock();
		let raf = 0, last = 0;
		function tick(now: number) {
			t += now - last;
			last = now;
			draw(t);
			raf = t < FADE_AT + FADE_MS ? requestAnimationFrame(tick) : 0;
		}
		function run() {
			if (raf) return;
			last = performance.now();
			raf = requestAnimationFrame(tick);
		}
		function stop() {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		}
		function finish() {
			stop();
			clock.clear();
			t = SCENE_BEATS.end;
			draw(t);
			hero!.classList.remove("is-playing");
			hero!.classList.add("is-done");
		}
		function play() {
			t = 0;
			hero!.classList.add("is-playing");
			run();
			clock.at("end", SCENE_BEATS.end, finish);
		}

		let settling: number | null = null;
		window.addEventListener("resize", () => {
			if (settling !== null) clearTimeout(settling);
			settling = window.setTimeout(layout, 120);
		});
		layout();
		/* the copy's webfonts move its lines: measure the holes again once they are in */
		document.fonts?.ready.then(layout);
		if (reduced) {
			hero.classList.add("is-done");
		} else {
			const img = hero.querySelector<HTMLImageElement>(".sky__photo")!;
			if (img.complete) play(); else img.addEventListener("load", play, { once: true });
		}
		/* pause freezes the frame where it is, the night, the drawing and the clock alike */
		pause.addEventListener("change", () => {
			hero.classList.toggle("is-paused", pause.checked);
			if (pause.checked) { clock.hold(); stop(); }
			else if (hero.classList.contains("is-playing")) { clock.resume(); run(); }
		});
		replay.addEventListener("click", () => {
			if (reduced) return;
			stop();
			clock.clear();
			pause.checked = false;
			hero.classList.remove("is-paused", "is-done", "is-playing");
			t = 0;
			draw(t);
			void hero.offsetWidth; /* a reflow between removing and re-adding the class, or the animations never restart */
			play();
		});
	}
</script>
