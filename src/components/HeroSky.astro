---
/**
 * HeroSky — the opening of the Big Data vertical (#556).
 *
 * Three robotic-telescope domes at the Teide Observatory, the sea and an island on the horizon. The founder's
 * story (2026-10-05, second round): night falls from left to right, a sweep across the sky; over the first
 * dome it picks stars — the first layer, bronze; reaching the second dome a second layer is composed that
 * reads from the first — silver; then the third — gold. What stays in the sky is the classic drawing of a
 * neural network, left to right: the medallion's layers, each reading from the one before. One star of the
 * first layer fails and is never read: the data that fails its tests never reaches gold. Then day comes back.
 *
 * The band, the copy, the epigraphs, the seal, the veil and the controls are the scene every vertical
 * shares (HeroScene.astro). The domes and the stars are measured on the photograph (`teide.py`); each layer's
 * column stands over its own dome. The night is a front the script moves across the photograph (under the
 * veil); the drawing is one canvas over the veil, the whole stage — at night the band IS the sky — with a hole
 * for every line of the copy.
 */
import { HERO_SKY, HERO_SKY_SIZES } from "../utils/hero-art";
import HeroScene from "./HeroScene.astro";

interface Props {
	title: string;
	excerptHtml: string;
	ctaLabel: string;
	contactPath: string;
	quote: any[] | null;
	labels: { get: (widget: string, key: string, fallback: string) => string };
}
const { title, excerptHtml, ctaLabel, contactPath, quote, labels } = Astro.props;
const L = (k: string, fb: string) => labels.get("panel_labels", k, fb);
const pauseLabel = L("sky_pause", "Pausar la animación");
const replayLabel = L("sky_replay", "Repetir la animación");
---

<HeroScene scene="sky" title={title} excerptHtml={excerptHtml} ctaLabel={ctaLabel} contactPath={contactPath} quote={quote} pauseLabel={pauseLabel} replayLabel={replayLabel}>
	<div slot="under" class="sky__box">
		<img class="sky__photo" src={HERO_SKY.photo} srcset={`${HERO_SKY.photoSmall} 720w, ${HERO_SKY.photo} 1320w, ${HERO_SKY.photoLarge} 2016w`} sizes={HERO_SKY_SIZES} width="1320" height="880" alt="" fetchpriority="high" decoding="async" />
		<span class="sky__night" aria-hidden="true"></span>
	</div>
	<canvas slot="over" class="sky__data" aria-hidden="true"></canvas>
	<i slot="over" class="sky__ink sky__ink--line" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--bronze" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--silver" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--gold" aria-hidden="true"></i>
	<i slot="over" class="sky__ink sky__ink--fail" aria-hidden="true"></i>
</HeroScene>

<script>
	import { SCENE_ROW, SCENE_BEATS } from "../utils/hero-art";
	import { SceneClock } from "../utils/scene-clock";
	import sky from "../assets/hero/bd-cielo.json";
	const hero = document.querySelector<HTMLElement>(".s-hero--sky");
	if (hero) {
		const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const stage = hero.querySelector<HTMLElement>(".s-hero__stage")!;
		const seal = hero.querySelector<SVGElement>(".scene__seal")!;
		const canvas = hero.querySelector<HTMLCanvasElement>(".sky__data")!;
		const ctx = canvas.getContext("2d")!;
		const pause = hero.querySelector<HTMLInputElement>(".scene__pause")!;
		const replay = hero.querySelector<HTMLButtonElement>(".scene__replay")!;

		const [FW, FH] = sky.frame;
		const ASPECT = FW / FH;                  /* the whole photograph */
		const BAND_H = 0.86;                     /* the frame's height, of the band's */
		const BLEED = 0.02;                      /* how far past the band's edge the frame runs */
		const SEAL_R = 0.93;                     /* the seal's right vertex, of its width (186 of 200) */
		const FROM_FADE = 140;                   /* px over which the drawing fades in past the seal */
		const SEA = sky.sea;                     /* the sea horizon's row: the sky ends there */
		/* the left dome's left edge, of the frame's width: the frame shrinks before it goes under the seal */
		const DOME_L = Math.min(...sky.domes[0].p.filter((_, i) => i % 2 === 0)) / FW;
		/* the network: nodes per layer, bronze to gold, and the one bronze node that fails its tests */
		const LAYERS = [6, 4, 2];
		const FAILS = 4;

		type Geo = { L: number; T: number; W: number; H: number };
		type Box = { l: number; t: number; r: number; b: number };
		type Node = { x: number; y: number };
		let geo: Geo = { L: 0, T: 0, W: 0, H: 0 };
		let holes: Box[] = [];
		let nodes: Node[][] = [];
		let from = 0;                            /* where the drawing may start: past the seal on desktops */
		let dpr = 1;

		/* the colours are the stylesheet's (tokens), resolved through hidden inks */
		function ink(k: string) {
			const el = hero!.querySelector(`.sky__ink--${k}`) as HTMLElement;
			return getComputedStyle(el).color;
		}
		let LINE = "", TIERS: string[] = [], FAIL = "";

		/* desktops: sized by the band, resting on its floor, running off its right edge like every scene; where
		   the band is narrow the frame shrinks so the left dome clears the seal */
		function fitWide(s: DOMRect): Geo {
			const sr = seal.getBoundingClientRect();
			from = sr.left - s.left + SEAL_R * sr.width + 8;
			const full = ASPECT * BAND_H * s.height;
			const room = (s.width - from - FROM_FADE) / (1 - BLEED - DOME_L);
			const W = Math.max(0.6 * full, Math.min(full, room)), H = W / ASPECT;
			const L = s.width + BLEED * W - W;
			hero!.style.setProperty("--sclip", `${Math.max(0, from - L)}px`);
			return { L, T: s.height - H, W, H };
		}
		/* phones and tablets: the scene is its own row under the copy, contained in it, flush right, as wide as
		   keeps the left dome in */
		function fitNarrow(s: DOMRect): Geo {
			const W = Math.min(1.25 * s.width, ASPECT * s.height, (s.width - 8) / (1 - BLEED - DOME_L)), H = W / ASPECT;
			from = 0;
			hero!.style.setProperty("--sclip", "0px");
			return { L: s.width - W * (1 - BLEED), T: (s.height - H) / 2, W, H };
		}
		/* every line of the copy, padded: the drawing never crosses a letter */
		function textBoxes(s: DOMRect): Box[] {
			const out: Box[] = [];
			const pad = (q: DOMRect): Box => ({ l: q.left - s.left - 14, r: q.right - s.left + 14, t: q.top - s.top - 10, b: q.bottom - s.top + 10 });
			for (const el of hero!.querySelectorAll<HTMLElement>(".s-hero__copy h1, .s-hero__body p, .s-hero__epigraph p, .s-hero__epigraph figcaption")) {
				const r = document.createRange();
				r.selectNodeContents(el);
				for (const q of r.getClientRects()) if (q.width > 2) out.push(pad(q));
			}
			for (const sel of [".s-hero__copy .btn", ".scene__ctl"]) {
				const b = hero!.querySelector<HTMLElement>(sel)?.getBoundingClientRect();
				if (b) out.push(pad(b));
			}
			return out;
		}
		/* the frame's pixels on the stage */
		const sx = (x: number) => geo.L + (x * geo.W) / FW;
		const sy = (y: number) => geo.T + (y * geo.H) / FH;
		/* the network's columns stand over the domes, in the sky between the band's visible top and whichever
		   comes first, the copy or the sea horizon; each layer is centred on the same line */
		function network(s: DOMRect, narrow: boolean) {
			const head = document.querySelector("header")?.getBoundingClientRect();
			const top = Math.max(12, (head ? head.bottom - s.top : 0) + 20);
			const h1 = hero!.querySelector(".s-hero__copy h1")?.getBoundingClientRect();
			const bottom = Math.min(sy(SEA) - 16, !narrow && h1 ? h1.top - s.top - 24 : Infinity);
			const mid = (top + bottom) / 2, span = Math.max(40, bottom - top);
			nodes = LAYERS.map((n, k) => {
				const x = sx(sky.domes[k].c[0]);
				const gap = Math.min(40, span / n);
				return Array.from({ length: n }, (_, i) => ({ x, y: mid + (i - (n - 1) / 2) * gap }));
			});
		}
		function layout() {
			const s = stage.getBoundingClientRect();
			const narrow = matchMedia(SCENE_ROW).matches;
			geo = narrow ? fitNarrow(s) : fitWide(s);
			holes = narrow ? [] : textBoxes(s);
			hero!.style.setProperty("--sx", `${geo.L}px`);
			hero!.style.setProperty("--sy", `${geo.T}px`);
			hero!.style.setProperty("--sw", `${geo.W}px`);
			hero!.style.setProperty("--sfade-l", `${Math.round(0.14 * geo.W)}px`);
			hero!.style.setProperty("--sfade-b", narrow ? `${Math.round(0.12 * geo.H)}px` : "0px");
			dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.round(s.width * dpr);
			canvas.height = Math.round(s.height * dpr);
			network(s, narrow);
			LINE = ink("line"); TIERS = [ink("bronze"), ink("silver"), ink("gold")]; FAIL = ink("fail");
			hero!.classList.add("is-placed");
			draw(t);
		}

		/* the timeline, in ms from the start (SCENE_BEATS). The night's front crosses the stage between --beat-draw
		   and --beat-drawn, from the seal to past the band's right edge; a layer forms when the front reaches its
		   dome. After it, the forward pass: pulses run along the links, bronze to gold. Day comes back from 6.5 s */
		const NIGHT_AT = SCENE_BEATS.draw, NIGHT_MS = SCENE_BEATS.drawn - NIGHT_AT;
		const SOFT = 160;                        /* the front's soft edge, px */
		const LINK_MS = 450, NODE_MS = 300, BEAM_MS = 400;
		const PULSE_AT = SCENE_BEATS.drawn + 200, PULSE_MS = 900, PULSES = 2;
		const DAY_AT = 6500, DAY_MS = 1100;
		const clamp = (x: number) => Math.min(1, Math.max(0, x));
		const ease = (x: number) => x * x * (3 - 2 * x);
		/* the front's position on the stage, and when it reaches stage column x */
		const runway = () => canvas.width / dpr - from + SOFT;
		const frontX = (ms: number) => from + runway() * clamp((ms - NIGHT_AT) / NIGHT_MS);
		const reached = (x: number) => NIGHT_AT + (NIGHT_MS * (x - from)) / runway();
		const STARS = sky.stars;

		/* the night under the veil: a front with a soft edge, moved across the photograph; day lifts it */
		function night(ms: number) {
			const u = (ms - NIGHT_AT) / (DAY_AT + DAY_MS - NIGHT_AT), on = u === clamp(u);
			hero!.style.setProperty("--night-x", `${(frontX(ms) - geo.L).toFixed(1)}px`);
			hero!.style.setProperty("--night-a", on ? (1 - ease(clamp((ms - DAY_AT) / DAY_MS))).toFixed(3) : "0");
		}

		let t = 0;
		function draw(ms: number) {
			night(ms);
			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			if (ms < NIGHT_AT || ms >= DAY_AT + DAY_MS) return;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const fade = 1 - ease(clamp((ms - DAY_AT) / DAY_MS));
			const fx = frontX(ms);

			/* the stars the night reveals as it passes */
			const size = Math.max(0.8, Math.min(1.3, (4 * geo.W) / FW));
			ctx.fillStyle = LINE;
			for (let i = 0; i < STARS.length; i += 3) {
				const x = sx(STARS[i]);
				const a = clamp((fx - SOFT / 2 - x) / SOFT);
				if (a <= 0) continue;
				const r = [0.7, 1.1, 1.7][STARS[i + 2]] * size;
				ctx.globalAlpha = fade * a * [0.35, 0.55, 0.85][STARS[i + 2]];
				ctx.fillRect(x - r, sy(STARS[i + 1]) - r, 2 * r, 2 * r);
			}

			/* the domes light up in their layer's colour as their layer forms */
			ctx.lineWidth = 1.75;
			ctx.lineJoin = "round";
			sky.domes.forEach((d, n) => {
				const u = clamp((ms - reached(sx(d.c[0]))) / NODE_MS);
				if (u <= 0) return;
				ctx.globalAlpha = fade * u * 0.9;
				ctx.strokeStyle = TIERS[n];
				ctx.beginPath();
				for (let i = 0; i < d.p.length; i += 2) {
					if (i) ctx.lineTo(sx(d.p[i]), sy(d.p[i + 1]));
					else ctx.moveTo(sx(d.p[i]), sy(d.p[i + 1]));
				}
				ctx.stroke();
			});

			/* each telescope's beam: from its dome up to the layer it composes, in that layer's colour */
			ctx.lineWidth = 1.5;
			sky.domes.forEach((d, n) => {
				const u = ease(clamp((ms - reached(sx(d.c[0]))) / BEAM_MS));
				if (u <= 0) return;
				const x = sx(d.c[0]), y0 = sy(d.c[1]) - 6, col = nodes[n], y1 = col[col.length - 1].y + 12;
				const y = y0 + (y1 - y0) * u;
				const g = ctx.createLinearGradient(0, y0, 0, y1);
				g.addColorStop(0, TIERS[n]);
				g.addColorStop(1, "rgba(0, 0, 0, 0)");
				ctx.strokeStyle = g;
				ctx.globalAlpha = fade * 0.75;
				ctx.beginPath();
				ctx.moveTo(x, y0);
				ctx.lineTo(x, y);
				ctx.stroke();
			});

			/* the links: each layer reads from the one before, drawn out of it as the front reaches the new
			   layer; the failed node is never read */
			ctx.lineWidth = 1;
			ctx.strokeStyle = LINE;
			for (let n = 1; n < nodes.length; n++) {
				const u = ease(clamp((ms - reached(nodes[n][0].x) + LINK_MS * 0.6) / LINK_MS));
				if (u <= 0) continue;
				ctx.globalAlpha = fade * 0.55;
				nodes[n - 1].forEach((a, i) => {
					if (n === 1 && i === FAILS) return;
					for (const b of nodes[n]) {
						ctx.beginPath();
						ctx.moveTo(a.x, a.y);
						ctx.lineTo(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u);
						ctx.stroke();
					}
				});
			}

			/* the forward pass: pulses run from bronze to gold along the links */
			for (let p = 0; p < PULSES; p++) {
				const v = (ms - PULSE_AT - p * PULSE_MS * 0.6) / PULSE_MS;
				if (v !== clamp(v)) continue;
				const seg = v * (nodes.length - 1), n = Math.min(nodes.length - 2, Math.floor(seg)), f = seg - n;
				ctx.fillStyle = TIERS[n + 1];
				ctx.globalAlpha = fade * Math.sin(Math.PI * f) * 0.9;
				nodes[n].forEach((a, i) => {
					if (n === 0 && i === FAILS) return;
					for (const b of nodes[n + 1]) {
						ctx.beginPath();
						ctx.arc(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f, 1.8, 0, 2 * Math.PI);
						ctx.fill();
					}
				});
			}

			/* the nodes: a ring closes on a star as the front picks it, then it fills in its layer's colour; the
			   failing one turns red and dims as the next layer forms without it */
			nodes.forEach((layer, n) => {
				layer.forEach((a, i) => {
					const u = clamp((ms - reached(a.x) - i * 40) / NODE_MS);
					if (u <= 0) return;
					const fail = n === 0 && i === FAILS ? clamp((ms - reached(nodes[1][0].x) + LINK_MS) / NODE_MS) : 0;
					const glow = n === nodes.length - 1 ? clamp((ms - PULSE_AT - PULSE_MS) / 400) : 0;
					const r = (n === nodes.length - 1 ? 6.5 : 5) + glow * 2;
					const c = fail > 0.5 ? FAIL : TIERS[n];
					ctx.globalAlpha = fade * (1 - 0.6 * fail);
					ctx.strokeStyle = c;
					ctx.lineWidth = 1.5;
					ctx.beginPath();
					ctx.arc(a.x, a.y, r + 10 * (1 - ease(u)), 0, 2 * Math.PI);
					ctx.stroke();
					ctx.fillStyle = c;
					ctx.globalAlpha = fade * ease(u) * (1 - 0.6 * fail);
					ctx.beginPath();
					ctx.arc(a.x, a.y, r - 1.5, 0, 2 * Math.PI);
					ctx.fill();
				});
			});

			/* a hole for every line of the copy (erased, not clipped — the padded lines overlap, and an even-odd
			   clip paints their overlaps back), and a fade in from the seal */
			ctx.globalCompositeOperation = "destination-out";
			ctx.globalAlpha = 1;
			ctx.fillStyle = "#000";               /* what is erased is the alpha: any opaque colour */
			for (const h of holes) ctx.fillRect(h.l, h.t, h.r - h.l, h.b - h.t);
			if (from > 0) {
				const g = ctx.createLinearGradient(from, 0, from + FROM_FADE, 0);
				g.addColorStop(0, "rgba(0, 0, 0, 1)");
				g.addColorStop(1, "rgba(0, 0, 0, 0)");
				ctx.fillStyle = g;
				ctx.fillRect(0, 0, from + FROM_FADE, canvas.height / dpr);
			}
			ctx.globalCompositeOperation = "source-over";
			ctx.globalAlpha = 1;
		}

		const clock = new SceneClock();
		let raf = 0, last = 0;
		function tick(now: number) {
			t += now - last;
			last = now;
			draw(t);
			raf = t < DAY_AT + DAY_MS ? requestAnimationFrame(tick) : 0;
		}
		function run() {
			if (raf) return;
			last = performance.now();
			raf = requestAnimationFrame(tick);
		}
		function stop() {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		}
		function finish() {
			stop();
			clock.clear();
			t = SCENE_BEATS.end;
			draw(t);
			hero!.classList.remove("is-playing");
			hero!.classList.add("is-done");
		}
		function play() {
			t = 0;
			hero!.classList.add("is-playing");
			run();
			clock.at("end", SCENE_BEATS.end, finish);
		}

		let settling: number | null = null;
		window.addEventListener("resize", () => {
			if (settling !== null) clearTimeout(settling);
			settling = window.setTimeout(layout, 120);
		});
		layout();
		/* the copy's webfonts move its lines: measure the holes again once they are in */
		document.fonts?.ready.then(layout);
		if (reduced) {
			hero.classList.add("is-done");
		} else {
			const img = hero.querySelector<HTMLImageElement>(".sky__photo")!;
			if (img.complete) play(); else img.addEventListener("load", play, { once: true });
		}
		/* pause freezes the frame where it is, the night, the drawing and the clock alike */
		pause.addEventListener("change", () => {
			hero.classList.toggle("is-paused", pause.checked);
			if (pause.checked) { clock.hold(); stop(); }
			else if (hero.classList.contains("is-playing")) { clock.resume(); run(); }
		});
		replay.addEventListener("click", () => {
			if (reduced) return;
			stop();
			clock.clear();
			pause.checked = false;
			hero.classList.remove("is-paused", "is-done", "is-playing");
			t = 0;
			draw(t);
			void hero.offsetWidth; /* a reflow between removing and re-adding the class, or the animations never restart */
			play();
		});
	}
</script>
