---
/**
 * HeroStore — the opening of the e-commerce vertical (#551).
 *
 * An automated warehouse, robots on the rails of its grid, told in four beats (founder, 2026-10-04/05):
 *
 * 1. the warehouse as it is;
 * 2. the stock: a lid lights up on every cell, in a wave from the order's cell — under the rails, every
 *    cell holds a stack of bins;
 * 3. your order: one bin rises out of its cell as a perfect cube and turns until it is seen exactly as
 *    the logo draws it, the hexagon and the Y;
 * 4. it becomes the logo, where it stands (founder, 2026-10-05: "mi logo no solo es un cubo"): the cube
 *    takes the house mark's exact geometry (SiteMark's, 200 x 228), its faces split 2 x 2, and the two
 *    plates of logo.svg come in behind it — the light one in the section's colour, the dark one turned.
 *    The logo was born of these hives (reference/legacy/docs/logo.md). The drawing goes, the photograph stays.
 *
 * The band, the copy, the epigraphs, the seal, the veil and the controls are the scene every vertical
 * shares (HeroScene.astro). Everything is measured on the photograph (`ocado.py`): the lids are the floor's
 * cells through the camera fitted to the rails, and the cube is projected through the same camera, frame
 * by frame, so the browser only plays what was computed.
 */
import { HERO_STORE, HERO_STORE_SIZES } from "../utils/hero-art";
import HeroScene from "./HeroScene.astro";
import drawing from "../assets/hero/ec-almacen.svg?raw";

interface Props {
	title: string;
	excerptHtml: string;
	ctaLabel: string;
	contactPath: string;
	quote: any[] | null;
	labels: { get: (widget: string, key: string, fallback: string) => string };
}
const { title, excerptHtml, ctaLabel, contactPath, quote, labels } = Astro.props;
const L = (k: string, fb: string) => labels.get("panel_labels", k, fb);
const pauseLabel = L("store_pause", "Pausar la animación");
const replayLabel = L("store_replay", "Repetir la animación");
---

<HeroScene scene="store" title={title} excerptHtml={excerptHtml} ctaLabel={ctaLabel} contactPath={contactPath} quote={quote} pauseLabel={pauseLabel} replayLabel={replayLabel}>
	<div slot="under" class="store__box">
		<img class="store__photo" src={HERO_STORE.photo} srcset={`${HERO_STORE.photoSmall} 720w, ${HERO_STORE.photo} 1320w, ${HERO_STORE.photoLarge} 2016w`} sizes={HERO_STORE_SIZES} width="1320" height="714" alt="" fetchpriority="high" decoding="async" />
		<div class="store__drawing" aria-hidden="true" set:html={drawing} />
	</div>
	<svg slot="under" class="store__order" aria-hidden="true">
		{/* the logo, placed by the script where the cube turns: in the mark's own 200 x 228 space; the plates are
		    logo.svg's (its 68 x 68 frame mapped so its cube lands on this one) */}
		<g class="store__logo">
			<g transform="matrix(3.78,0,0,3.78,-27.9,-13.1)">
				<path class="store__plate store__plate--back" d="M17.7764 3.94218C33.9811 6.8248 50.1858 9.70743 59.1352 11.2994C62.8739 11.9645 64.4148 14.1728 63.758 17.9244C62.0299 27.7959 60.3028 37.6615 56.4924 59.4268C55.8357 63.1785 53.638 64.7217 49.8993 64.0567C35.821 61.5523 21.7484 59.049 8.5405 56.6994C4.80185 56.0344 3.26091 53.826 3.91769 50.0744C5.57605 40.6015 7.23544 31.1228 11.1833 8.57203C11.8401 4.8204 14.0378 3.27712 17.7764 3.94218Z" />
				<path class="store__plate store__plate--front" d="M12.8495 7.19339C28.6413 7.19339 44.4332 7.19339 54.8188 7.19339C58.6127 7.19339 60.5096 9.09949 60.5096 12.9117C60.5096 21.8048 60.5096 30.6979 60.5096 55.0841C60.5096 58.8963 58.6127 60.8024 54.8188 60.8024C45.1445 60.8024 35.4702 60.8024 12.8495 60.8024C9.05561 60.8024 7.15869 58.8963 7.15869 55.0841C7.15869 42.7659 7.15869 30.4478 7.15869 12.9117C7.15869 9.09949 9.05561 7.19339 12.8495 7.19339Z" />
			</g>
			<path class="store__edge" pathLength="1" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z" />
			<path class="store__edge" pathLength="1" d="M14,64 100,114 186,64 M100,114 100,214" />
			<path class="store__edge store__edge--grid" pathLength="1" d="M57,39 143,89 M143,39 57,89" />
			<path class="store__edge store__edge--grid" pathLength="1" d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114" />
		</g>
		<path class="store__face store__face--a" />
		<path class="store__face store__face--b" />
		<path class="store__face store__face--c" />
	</svg>
</HeroScene>

<script>
	import { SCENE_ROW } from "../utils/hero-art";
	import { SceneClock } from "../utils/scene-clock";
	import cube from "../assets/hero/ec-pedido.json";
	const hero = document.querySelector<HTMLElement>(".s-hero--store");
	if (hero) {
		const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const stage = hero.querySelector<HTMLElement>(".s-hero__stage")!;
		const inner = hero.querySelector<HTMLElement>(".s-hero__inner")!;
		const seal = hero.querySelector<SVGElement>(".scene__seal")!;
		const box = hero.querySelector<HTMLElement>(".store__box")!;
		const order = hero.querySelector<SVGSVGElement>(".store__order")!;
		const faces = [...order.querySelectorAll<SVGPathElement>(".store__face")];
		const pause = hero.querySelector<HTMLInputElement>(".scene__pause")!;
		const replay = hero.querySelector<HTMLButtonElement>(".scene__replay")!;

		const [FW, FH] = cube.frame;
		const ASPECT = FW / FH;                  /* the photograph's frame, its ceiling cropped */
		const BAND_H = 0.86;                     /* the frame's height, of the band's */
		const ORDER = 0.69;                      /* where the order's cube starts, of the frame's width: past the column */
		const BLEED = 0.02;                      /* how far past the band's edge the frame runs */
		const SEAL_R = 0.93;                     /* the seal's right vertex, of its width (186 of 200) */
		/* the house mark's cube (SiteMark, the seal; 200 x 228): T, UR, LR, B, LL, UL and the centre of the Y */
		const MARK = [100, 14, 186, 64, 186, 164, 100, 214, 14, 164, 14, 64, 100, 114];
		const logo = hero.querySelector<SVGGElement>(".store__logo")!;
		type Geo = { L: number; T: number; W: number; H: number };
		let geo: Geo = { L: 0, T: 0, W: 0, H: 0 };

		/* desktops: sized by the band, resting on its floor, running off its right edge like every scene; when the
		   band is narrow the frame shrinks (to half) so the order's cube stays past the column */
		function fitWide(s: DOMRect): Geo {
			const cs = getComputedStyle(inner), ib = inner.getBoundingClientRect();
			const colR = ib.right - s.left - parseFloat(cs.paddingRight);
			const sr = seal.getBoundingClientRect();
			const sealR = sr.left - s.left + SEAL_R * sr.width + 8;
			const full = ASPECT * BAND_H * s.height;
			const room = (s.width * (1 + BLEED) - colR) / (1 - ORDER);
			const W = Math.max(full / 2, Math.min(full, room)), H = W / ASPECT;
			const L = s.width + BLEED * W - W;
			hero!.style.setProperty("--sclip", `${Math.max(0, sealR - L)}px`);
			return { L, T: s.height - H, W, H };
		}
		/* phones and tablets: the scene is its own row under the copy, contained in it, flush right */
		function fitNarrow(s: DOMRect): Geo {
			const W = Math.min(1.25 * s.width, ASPECT * s.height), H = W / ASPECT;
			hero!.style.setProperty("--sclip", "0px");
			return { L: s.width - W * (1 - BLEED), T: (s.height - H) / 2, W, H };
		}
		function layout() {
			const s = stage.getBoundingClientRect();
			const narrow = matchMedia(SCENE_ROW).matches;
			geo = narrow ? fitNarrow(s) : fitWide(s);
			hero!.style.setProperty("--sx", `${geo.L}px`);
			hero!.style.setProperty("--sy", `${geo.T}px`);
			hero!.style.setProperty("--sw", `${geo.W}px`);
			hero!.style.setProperty("--sfade-l", `${Math.round(0.14 * geo.W)}px`);
			hero!.style.setProperty("--sfade-b", narrow ? `${Math.round(0.12 * geo.H)}px` : "0px");
			hero!.classList.add("is-placed");
			if (t > 0) draw(t);
		}

		/* the cube is played on the stage's own pixels: the photograph's for the frames, the seal's for the flight */
		const at = (x: number, y: number) => [geo.L + (x * geo.W) / FW, geo.T + (y * geo.H) / FH];
		const poly = (p: number[]) => {
			let d = "";
			for (let i = 0; i < p.length; i += 2) { const [x, y] = at(p[i], p[i + 1]); d += `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`; }
			return d + "Z";
		};
		const quad = (q: number[], idx: number[]) => "M" + idx.map((i) => `${q[2 * i].toFixed(1)},${q[2 * i + 1].toFixed(1)}`).join("L") + "Z";
		/* the hexagon as three faces: the top, then the two the Y divides */
		const TOPF = [0, 1, 6, 5], LEFTF = [5, 6, 3, 4], RIGHTF = [6, 1, 2, 3];
		const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

		/* the timeline, in ms from the start: the CSS plays the photograph, the lids and the logo's entrance; this
		   plays the cube's frames, then eases its seven points onto the mark's and places the logo there */
		const CUBE_AT = 4200, N = cube.frames.length, FRAME_MS = 1000 / cube.fps;
		const MARK_AT = CUBE_AT + N * FRAME_MS, MARK_MS = 400;
		let t = 0;
		function draw(ms: number) {
			if (ms < CUBE_AT) { order.classList.remove("is-on"); return; }
			order.classList.add("is-on");
			const k = Math.floor((ms - CUBE_AT) / FRAME_MS);
			if (k < N) {
				const fr = cube.frames[k];
				faces.forEach((f, i) => {
					const face = fr[i];
					f.setAttribute("d", face ? poly(face.p) : "");
					f.classList.toggle("is-top", face?.k === "top");
				});
				order.style.setProperty("--mark", "0");
				return;
			}
			/* the turned cube and the mark's cube, same centre and width: the turn ends at the mark's own elevation
			   (isometric), so the last stretch only corrects what the photograph's perspective bends */
			const from: number[] = [];
			for (let i = 0; i < 14; i += 2) from.push(...at(cube.hexagon[i], cube.hexagon[i + 1]));
			const cx = (from[0] + from[6]) / 2, cy = (from[1] + from[7]) / 2;
			const scale = (from[2] - from[10]) / 172;
			const to = MARK.map((v, i) => (i % 2 ? cy + (v - 114) * scale : cx + (v - 100) * scale));
			logo.setAttribute("transform", `translate(${(cx - 100 * scale).toFixed(1)},${(cy - 114 * scale).toFixed(1)}) scale(${scale.toFixed(4)})`);
			const u = ease(Math.min(1, Math.max(0, (ms - MARK_AT) / MARK_MS)));
			const q = from.map((v, i) => v + (to[i] - v) * u);
			faces[0].setAttribute("d", quad(q, TOPF));
			faces[1].setAttribute("d", quad(q, LEFTF));
			faces[2].setAttribute("d", quad(q, RIGHTF));
			faces[0].classList.add("is-top");
			faces[1].classList.remove("is-top");
			faces[2].classList.remove("is-top");
			order.style.setProperty("--mark", String(u));
		}

		const clock = new SceneClock();
		let raf = 0, last = 0;
		function tick(now: number) {
			t += now - last;
			last = now;
			draw(t);
			raf = t < MARK_AT + MARK_MS ? requestAnimationFrame(tick) : 0;
		}
		function run() {
			if (raf) return;
			last = performance.now();
			raf = requestAnimationFrame(tick);
		}
		function stop() {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		}
		function finish() {
			stop();
			clock.clear();
			order.classList.remove("is-on");
			hero!.classList.remove("is-playing");
			hero!.classList.add("is-done");
		}
		function play() {
			t = 0;
			hero!.classList.add("is-playing");
			run();
			clock.at("end", 8000, finish);
		}

		let settling: number | null = null;
		window.addEventListener("resize", () => {
			if (settling !== null) clearTimeout(settling);
			settling = window.setTimeout(layout, 120);
		});
		layout();
		if (reduced) {
			hero.classList.add("is-done");
		} else {
			const img = hero.querySelector<HTMLImageElement>(".store__photo")!;
			if (img.complete) play(); else img.addEventListener("load", play, { once: true });
		}
		/* pause freezes the frame where it is, the lids, the cube and the clock alike; play goes on from there */
		pause.addEventListener("change", () => {
			hero.classList.toggle("is-paused", pause.checked);
			if (pause.checked) { clock.hold(); stop(); }
			else if (hero.classList.contains("is-playing")) { clock.resume(); run(); }
		});
		replay.addEventListener("click", () => {
			if (reduced) return;
			stop();
			clock.clear();
			pause.checked = false;
			hero.classList.remove("is-paused", "is-done", "is-playing");
			order.classList.remove("is-on");
			void hero.offsetWidth; /* a reflow between removing and re-adding the class, or the animations never restart */
			play();
		});
	}
</script>
