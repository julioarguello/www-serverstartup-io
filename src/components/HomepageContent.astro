---
/**
 * HomepageContent — shared homepage layout component.
 *
 * Extracts the common homepage rendering logic used by both
 * index.astro (ES) and en/index.astro (EN).
 *
 * Content source: pages/home (EmDash CMS, locale-scoped). Its PT content is
 * the hero's two lines under the heading, read BY POSITION.
 *
 * Band order on the page (#580, founder 2026-10-09, after comparing seven
 * reference homes): hero · client logos (no heading) · «Cómo trabajamos» ·
 * mantra · Cloudflare partner · CTA. «Áreas de especialización» left: the
 * «nosotros» frame's card is now the index of the six verticals, and the
 * carousel shows each one. «Calidad y rendimiento» left too ("queda ahí como
 * tira de nadie").
 *
 * CTA block sourced from cta_global widget area.
 * Hero slides derived from the services collection.
 * Cloudflare partner block driven by the partners collection.
 */
import { getEmDashEntry, getEmDashCollection } from "emdash";
import CloudflarePartner from "./CloudflarePartner.astro";
import { PortableText } from "emdash/ui";
import PtLink from "./PtLink.astro";
import CtaGlobal from "./CtaGlobal.astro";
import ReferenceBanner from "./ReferenceBanner.astro";
import MantraCloser from "./MantraCloser.astro";
import { FACE_BY_SLUG } from "../utils/nav";
import { getUiLabels } from "../utils/ui-labels";
import { excerptHtml } from "../utils/excerpt";
import { HERO_TAIL, HOME_PHOTO, HOME_PHOTO_SIZES, homePhotoSources, sortByVoyage, type HomePhoto } from "../utils/hero-art";

// Whitespace-safe link mark: EmDash's default renderer inserts a space
// before punctuation that follows a link (#273 — the hero is link-heavy)
const ptComponents = { mark: { link: PtLink } };
const t = Astro.locals.t;

const locale = Astro.currentLocale || "es";
const localePrefix = locale === "es" ? "" : `/${locale}`;

const { entry } = await getEmDashEntry("pages", "home", { locale });
if (!entry) return Astro.rewrite("/404");
// No cache.set in components: it runs mid-stream, after headers — the home
// served cf-cache-status BYPASS until the #357 E2E caught it. The hint is
// set in the index pages' frontmatter; footer tags come from middleware.

const { title, content } = entry.data;

// The two-voice title (#580, brief §3.2): the head in the house face, the
// tail — everything after the first comma — in Computer Modern italic,
// coloured by the frame on screen. Split here, never in the CMS: the title
// stays one string for SEO, the <title> element and a screen reader.
const comma = title.indexOf(",");
const titleHead = comma === -1 ? title : title.slice(0, comma + 1);
const titleTail = comma === -1 ? "" : title.slice(comma + 1).trim();

// Fetch services collection for the slides
const { entries: serviceEntries } = await getEmDashCollection("services", {
	orderBy: { created_at: "asc" },
	locale,
});
const services = serviceEntries ?? [];

const labels = await getUiLabels(locale);

// The short names are the menu's own `menu_short` (#428): the same six names,
// so no new copy to keep in sync. `us` is the brand frame's.
const short = labels.getAll("menu_short");

// ── The rotating hero (#413, the voyage since #560, «nosotros» since #580) ──
// Seven frames on one clock. The first is the company, not a vertical
// (founder: "Yo voy a la home y lo primero que veo es un faro… eso no me
// representa, eso es un vertical"): the logo's cube, lit, in the seal's place,
// and the card as the index of the six verticals. Then six photographs, one
// per vertical, in the voyage's order — the coast, the bridge, the tug under
// it, the museum, the warehouse, night over the Teide. The header's edge is
// handed the same list by Base (sortByVoyage), so the two cannot disagree.
//
// What changes in front of each picture is the vertical's name and one
// factual line, CMS `hero_line` keyed by face: what we do in that vertical,
// in a practitioner's words (founder 2026-10-09, brief §3.3). Markdown-lite —
// `code` and *italics* — rendered by the excerpt helper, as the service
// heroes do.
const lines = labels.getAll("hero_line");
const heroSlides = sortByVoyage(services).flatMap((svc: any) => {
	const slug = svc.slug ?? svc.id;
	const face = FACE_BY_SLUG[slug];
	if (!face) return [];
	return [{
		face,
		href: `${localePrefix}/${slug}`,
		title: svc.data.title as string,
		color: (svc.data.color as string) || "#1E1E1E",
		photo: HOME_PHOTO[face] as HomePhoto,
		line: excerptHtml(lines[face] ?? ((svc.data.excerpt as string) || "")),
		short: short[face] ?? (svc.data.title as string),
	}];
});
// Frame k ≥ 1 is slide k − 1; frame 0 is «nosotros».
const frames = heroSlides.length + 1;

// The tail's colour per frame, as custom properties the clock's keyframes
// read: `--tm*` on the flat band (phones, tablets), `--tp*` on the
// photograph (desktops). theme.css tokens, keyed by face in HERO_TAIL —
// never a copy of the palette here.
const tailVars = [
	"--tm0:var(--color-brand-grey);--tp0:var(--color-brand-grey)",
	...heroSlides.map((s, i) => `--tm${i + 1}:${HERO_TAIL[s.face].band};--tp${i + 1}:${HERO_TAIL[s.face].photo}`),
].join(";");

// «Cómo trabajamos» (#580, brief §3.4): seven items, a bold declarative
// phrase and one sentence each, from the `how_we_work` widget. Portable Text
// with its marks — the phrases carry `code` (SDD, SaaS) and the sentences
// code and italics. The label block is keyed `<id>`, its sentence `<id>_body`.
const how = labels.getBlocks("how_we_work");
const howHeading = how.get("heading")?.children?.map((c) => c.text ?? "").join("") ?? "";
const howItems = [...how.entries()]
	.filter(([key]) => key !== "heading" && !key.endsWith("_body"))
	.map(([key, label]) => ({ key, label, body: how.get(`${key}_body`) }));

// the deferred hero photos' src until the page has loaded (see the stage below)
const BLANK = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
// The «Filamento» cube: the logo's outline, its three inner edges and the
// six cell lines, in the seal's 200 × 228 drawing (HeroScene.astro).
const CUBE = {
	outline: "M100,14 186,64 186,164 100,214 14,164 14,64 Z M14,64 100,114 186,64 M100,114 100,214",
	spokes: ["M100,114 14,64", "M100,114 186,64", "M100,114 100,214"],
	ring: ["M14,64 100,14", "M186,64 100,14", "M186,64 186,164", "M100,214 186,164", "M100,214 14,164", "M14,64 14,164"],
	cells: "M57,39 143,89 M143,39 57,89 M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114",
};
---

<!-- ══════ HERO — «nosotros», then six photographs, one voyage (#413, #560, #580) ══════
     The picture rotates; the <h1> does not. One stable heading is what SEO
     and a screen reader read, and it is also the only honest one: the six
     verticals are what the company does, not six different companies. -->
<section class="s-hero s-hero--home" aria-label={t("hero_intro")} style={`--frames:${frames}`}>
	{heroSlides.length > 0 && (
		<div class="s-hero__stage" aria-hidden="true">
			{/* «nosotros» has no photograph (#580): the band's own ground, lit by
			    the cube, with the haze at its far edge. */}
			<span class="s-hero__haze"></span>
			{/* The six verticals' photographs, never their openings: the
			    animations belong to each vertical's page and would spoil it
			    (founder, 2026-10-05). Each holds still and cross-fades into the
			    next.

			    None loads with the page (#580): the first frame is «nosotros»,
			    with no photograph, and the first photograph is not due for six
			    seconds. They carry their sources as data until the page has
			    loaded, so they never compete with the <h1> — the home's LCP —
			    for the first screen's bytes. Until then their `src` is a
			    one-pixel transparent GIF: an <img> without one is invalid HTML
			    (html-validate in CI), and it costs no request. */}
			{heroSlides.map((slide, i) => {
				const { src, srcset } = homePhotoSources(slide.photo);
				return (
					<img
						class="s-hero__photo"
						src={BLANK}
						data-src={src}
						data-srcset={srcset}
						data-sizes={HOME_PHOTO_SIZES}
						alt=""
						width={slide.photo.width}
						height={slide.photo.height}
						style={`--i:${i + 1};--focus:${slide.photo.focus};--focus-n:${slide.photo.focusNarrow ?? slide.photo.focus}`}
						fetchpriority="low"
						decoding="async"
					/>
				);
			})}
			<span class="s-hero__scrim"></span>
		</div>
	)}
	{/* The seal and the cube are one drawing in one place (brief §3.1, option
	    4a): on «nosotros» the logo's cube is the subject — its edges light up
	    in paper white from the centre of the «Y» outwards («Filamento», chosen
	    2026-10-09) — and on the next frame it recedes to the faint outline in
	    that vertical's colour. Nothing moves between frames; only the light
	    changes ("el cubo aparece a la izquierda… es un sin Dios"). Seven
	    outlines, one per frame, dissolving on the photographs' clock. */}
	{heroSlides.length > 0 && (
		<svg class="s-hero__mark" viewBox="0 0 200 228" aria-hidden="true">
			<defs>
				<radialGradient id="hero-spill">
					<stop offset="0" class="s-hero__spill-0" />
					<stop offset=".5" class="s-hero__spill-1" />
					<stop offset="1" class="s-hero__spill-2" />
				</radialGradient>
				<filter id="hero-bloom" x="-20%" y="-20%" width="140%" height="140%">
					<feGaussianBlur stdDeviation="3" />
				</filter>
			</defs>
			<g class="s-hero__us">
				<circle class="s-hero__spill" cx="100" cy="114" r="134" fill="url(#hero-spill)" />
				<g class="s-hero__filament">
					<g class="s-hero__bloom" filter="url(#hero-bloom)">
						{CUBE.spokes.map((d) => <path class="s-hero__spoke" pathLength="1" d={d} />)}
						{CUBE.ring.map((d) => <path class="s-hero__ring" pathLength="1" d={d} />)}
					</g>
					<g class="s-hero__lines">
						{CUBE.spokes.map((d) => <path class="s-hero__spoke" pathLength="1" d={d} />)}
						{CUBE.ring.map((d) => <path class="s-hero__ring" pathLength="1" d={d} />)}
					</g>
					<path class="s-hero__cells" d={CUBE.cells} />
				</g>
			</g>
			<path class="s-hero__seal" d={CUBE.outline} style="--i:0" />
			{heroSlides.map((slide, i) => (
				<path class="s-hero__seal" d={CUBE.outline} style={`--i:${i + 1};--cc:${slide.color}`} />
			))}
		</svg>
	)}
	<div class="container s-hero__inner">
		{/* What the COMPANY is holds still — the <h1> and the two lines under it
		    are the same on all seven frames, which is also what SEO and a screen
		    reader read. Only the tail's colour follows the frame, in step with
		    the photograph (brief §3.2: "eso está mal" when it lingered). */}
		<h1 style={tailVars}>
			{titleHead}{titleTail && " "}{titleTail && <span class="ss-title__tail">{titleTail}</span>}
		</h1>
		{content?.length > 0 && (
			<div class="s-hero__kicker">
				{/* Two lines, read by position: the years and what they cover, then
				    the partnership (founder, 2026-10-06: "tres líneas: el titular, la
				    de más de veinte años y la de partners, y que nada salte de
				    línea"). Each fits its own line on any screen from 768 px up —
				    homepage.css sizes them by the longer one. */}
				<PortableText value={(content as any[]).slice(0, 2)} components={ptComponents} />
			</div>
		)}
		{/* ── the card: everything that rotates, inside one piece ──
		    Direction C, chosen by the founder 2026-08-27. Same position, same
		    chrome on all seven frames — the card never disappears, it changes
		    scale (brief §3.1): on «nosotros» it is the index of the six
		    verticals, each row a link; on each photograph it narrows to the one
		    vertical on screen, its name and what we do there. */}
		{heroSlides.length > 0 && (
			<div class="s-hero__card">
				{/* The card's rule takes the showing vertical's colour. It is
				    six stacked bars rather than a border on the card, because
				    the colour arrives with the slide from the CMS and CSS
				    keyframes cannot be told it. «nosotros» has none: each of its
				    rows carries its own. */}
				<span class="s-hero__rules" aria-hidden="true">
					{heroSlides.map((slide, i) => (
						<i class="s-hero__rule" style={`--i:${i + 1};--cc:${slide.color}`}></i>
					))}
				</span>
				<div class="s-hero__deck">
					<nav class="s-hero__verticals" aria-label={t("hero_index")} style="--i:0">
						<ul role="list">
							{heroSlides.map((slide) => (
								<li style={`--cc:${slide.color}`}>
									<a href={slide.href} class="s-hero__vlink">
										<i class="s-hero__vrule" aria-hidden="true"></i>
										{/* both names ship and the breakpoint picks one, as the menu
										    does (#428); `display:none` keeps the other out of the
										    accessibility tree */}
										<span class="s-hero__vname s-hero__vname--long">{slide.title}</span>
										<span class="s-hero__vname s-hero__vname--short">{slide.short}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
					<ul class="s-hero__index" role="list">
						{heroSlides.map((slide, i) => (
							<li class="s-hero__item" style={`--i:${i + 1};--cc:${slide.color}`}>
								<a href={slide.href} class="s-hero__link">
									<span class="s-hero__name">{slide.title}</span>
									<span class="s-hero__arrow" aria-hidden="true">&rarr;</span>
								</a>
								<p class="s-hero__pitch-item" set:html={slide.line} />
							</li>
						))}
					</ul>
				</div>
			</div>
		)}
		{heroSlides.length > 0 && (
			<div class="s-hero__ticker">
				{/* The rail is the navigation (brief §9.8: no arrows). It names the
				    stops instead of counting them: on a voyage "01 / 07" says
				    nothing, the names say the route. Each track fills in its
				    frame's colour while the frame shows. The stops become buttons
				    once the script is here to make them work — a control that does
				    nothing is worse than no control, and with no JS the CSS
				    rotation still carries the band on its own. */}
				<div class="s-hero__dots" aria-label={t("hero_rail")} role="group">
					<span class="s-hero__stop" style="--i:0;--cc:var(--color-brand-grey)">
						<span class="s-hero__dot"></span>
						<span class="s-hero__stop-name">{short.us ?? ""}</span>
					</span>
					{heroSlides.map((slide, i) => (
						<span class="s-hero__stop" style={`--i:${i + 1};--cc:${slide.color}`}>
							<span class="s-hero__dot"></span>
							<span class="s-hero__stop-name">{slide.short}</span>
						</span>
					))}
				</div>
			</div>
		)}
	</div>
	{/* WCAG 2.2.2: rotation that lasts more than five seconds needs a way to stop it. The verticals'
	    own control (scene-ctl.css), in the band's corner — a checkbox, so it stops the CSS clock with no
	    script: Tab reaches it, Space stops the band, its aria-label names it. No replay: a carousel
	    has nothing to start over. */}
	{heroSlides.length > 0 && (
		<div class="scene__ctl">
			<input type="checkbox" id="hero-pause" class="scene__pause" aria-label={t("hero_pause")} />
			<label for="hero-pause" class="scene__pause-btn"></label>
		</div>
	)}
</section>

<!-- ══════ CLIENT LOGOS — directly under the band, no heading (#580) ══════
     5 of the 7 reference homes the founder compared show logos, and none
     leaves them for the foot of the page. The only place client names appear. -->
<ReferenceBanner
	title={labels.get("footer_headings", "references_heading", locale === "en" ? "Who we have worked with" : "Con quién hemos trabajado")}
	more={labels.get("footer_headings", "references_all", locale === "en" ? "See all references" : "Ver todas las referencias")}
	href={`${locale === "en" ? "/en/references" : "/referencias"}`}
	ariaLabel={t("trust_section")}
	headless
/>

<!-- ══════ CÓMO TRABAJAMOS (#580) ══════
     Seven items, each a bold declarative phrase plus one sentence. No icons,
     no numbering, no cards (brief §3.4). Its last item is «Dicho y hecho», and
     the mantra follows it directly. -->
{howItems.length > 0 && (
	<section class="s-how" aria-labelledby="how-heading">
		<div class="container">
			<h2 id="how-heading">{howHeading}</h2>
			<ul class="s-how__list" role="list">
				{howItems.map((item) => (
					<li>
						<div class="s-how__label"><PortableText value={[item.label]} components={ptComponents} /></div>
						{item.body && <div class="s-how__body"><PortableText value={[item.body]} components={ptComponents} /></div>}
					</li>
				))}
			</ul>
		</div>
	</section>
)}

<div class="container mantra-wrap">
	<MantraCloser />
</div>

<!-- ══════ CLOUDFLARE PARTNER (CMS-driven) — exactly as it was, orange ground included ══════ -->
<CloudflarePartner />

<!-- ══════ CTA (from cta_global widget) ══════ -->
<CtaGlobal />

<script>
	/**
	 * The hero's manual control. The rotation itself stays in CSS — it is the
	 * LCP band and it must run with or without this file. All this does is
	 * load the photographs once the page is in, measure the card, and hand the
	 * visitor the wheel: the rail's stops become buttons (brief §9.8: the rail
	 * is the navigation, no arrows).
	 */
	const hero = document.querySelector<HTMLElement>(".s-hero--home");

	// The six photographs, once the page has loaded (#560, #580): in the
	// markup their sources are data, so they never compete with the first
	// screen's own bytes — the first is not on screen for six seconds.
	const later = () => {
		for (const img of document.querySelectorAll<HTMLImageElement>(".s-hero__photo[data-srcset]")) {
			// sizes first: it is only valid beside a srcset, so it travels as data too (#573)
			img.sizes = img.dataset.sizes ?? "";
			img.srcset = img.dataset.srcset ?? "";
			img.src = img.dataset.src ?? "";
			delete img.dataset.sizes;
			delete img.dataset.srcset;
			delete img.dataset.src;
		}
	};
	if (document.readyState === "complete") later();
	else window.addEventListener("load", later, { once: true });

	/**
	 * The card changes scale between the index and one vertical (brief §3.1).
	 * CSS cannot animate a height to `auto`, so the two heights are measured
	 * here and handed to the clock's keyframes as custom properties. The
	 * animation itself runs from the first paint either way — started later it
	 * would keep its own time, off the band's clock — and until the heights
	 * arrive both of its states are `auto`: the card holds the taller of the
	 * two, the same layout, never a broken one.
	 */
	const card = hero?.querySelector<HTMLElement>(".s-hero__card");
	const measure = () => {
		if (!hero || !card) return;
		const index = card.querySelector<HTMLElement>(".s-hero__verticals");
		const items = Array.from(card.querySelectorAll<HTMLElement>(".s-hero__item"));
		if (!index || !items.length) return;
		// grid items in one cell: their heights are their content's, whatever the deck's is
		const us = index.offsetHeight;
		const v = Math.max(...items.map((it) => it.offsetHeight));
		const cs = getComputedStyle(card);
		card.style.setProperty("--deck-us", `${us}px`);
		card.style.setProperty("--deck-v", `${v}px`);
		// the phone's cube stands above the card's tallest state
		hero.style.setProperty("--card-h", `${parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) + Math.max(us, v)}px`);
	};
	if (hero && card) {
		(document.fonts?.ready ?? Promise.resolve()).then(measure);
		let rz = 0;
		new ResizeObserver(() => {
			cancelAnimationFrame(rz);
			rz = requestAnimationFrame(measure);
		}).observe(hero);
	}

	/**
	 * The stops JUMP the band's clock to the chosen frame and the rotation goes
	 * on from there (founder, 2026-10-05: "si le doy a avanzar que no se
	 * desactive el play"). Every animation on the clock — the photographs, the
	 * card, the tracks, the cube, the tail and the header's edge — started
	 * together, so setting one time on all of them moves the whole band at
	 * once, paused or not.
	 */
	const stops = Array.from(hero?.querySelectorAll<HTMLElement>(".s-hero__stop") ?? []);
	const n = stops.length;
	if (hero && n > 1) {
		const secs = (name: string, fallback: number) => {
			const raw = getComputedStyle(hero).getPropertyValue(name).trim();
			const v = parseFloat(raw);
			if (!Number.isFinite(v)) return fallback;
			return raw.endsWith("ms") ? v / 1000 : v;
		};
		// the clock is the stylesheet's, read back rather than restated here
		const cycle = secs("--hero-cycle", 42) * 1000;
		const step = secs("--hero-step", 6) * 1000;
		// every frame's animation is delayed by `--i * step - 0.5 s`; one second in, the frame is whole
		const LEAD = 500, IN = 1000;
		const clocked = () => [
			...hero.getAnimations({ subtree: true }),
			...(document.querySelector(".site-header")?.getAnimations() ?? []),
		];
		const now = () => Number(hero.querySelector(".s-hero__seal")?.getAnimations()[0]?.currentTime ?? 0);
		const current = () => Math.floor(((((now() + LEAD) % cycle) + cycle) % cycle) / step) % n;
		const show = (i: number) => {
			const k = ((i % n) + n) % n;
			const round = Math.floor((now() + LEAD) / cycle) + 1;
			const at = round * cycle + k * step - LEAD + IN;
			for (const a of clocked()) a.currentTime = at;
		};
		stops.forEach((stop, i) => {
			const name = stop.querySelector(".s-hero__stop-name")?.textContent?.trim() ?? "";
			stop.setAttribute("role", "button");
			stop.setAttribute("aria-label", name);
			stop.tabIndex = 0;
			stop.addEventListener("click", () => { if (i !== current()) show(i); });
			stop.addEventListener("keydown", (e) => {
				if (e.metaKey || e.ctrlKey || e.altKey) return;
				let to: number | null = null;
				if (e.key === "ArrowRight") to = (i + 1) % n;
				else if (e.key === "ArrowLeft") to = (i + n - 1) % n;
				else if (e.key === "Home") to = 0;
				else if (e.key === "End") to = n - 1;
				else if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					show(i);
					return;
				}
				if (to === null) return;
				e.preventDefault();
				stops[to].focus();
				show(to);
			});
		});
		hero.classList.add("has-rail");
	}
</script>
