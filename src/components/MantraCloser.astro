---
/**
 * MantraCloser — the house signature, one implementation (#295).
 *
 * The line used to be written 14 times across the content, each page
 * giving it its own shape. Now the three beats live once per locale in the
 * CMS (ui_labels → mantra) and this component gives them their form, so a
 * new page cannot drift. Same move as the heading mark in #298.
 *
 * The form is a sequence set in Computer Modern (Knuth's TeX face,
 * self-hosted and subset), ending in the end-of-proof square (#579,
 * founder 2026-10-09, replacing #263's «Cero traspasos», which readers took
 * for a stock transfer or the sale of premises):
 *
 *     ⬢ 1 equipo  →  ▪▪▪▪▪▪ 6 verticales  →  ∎ dicho y hecho
 *
 * the logo's cube, the six vertical colours as a one-row glyph, and ∎ — the
 * Halmos tombstone, «quod erat demonstrandum» — in ink. The six coloured
 * squares and the ink square rhyme on purpose: six verticals, one finished
 * job. → and ∎ come from "CM Proof Symbols" (theme.css), Computer Modern's
 * own signs. Screen readers read «1 equipo. 6 verticales. Dicho y hecho.»
 * and skip the glyphs.
 *
 * Chrome: the house box (left rule + 4% ink tint), the same pattern and
 * margins as `.s-partner` — nothing invented here.
 */
import { getEmDashCollection } from "emdash";
import { getUiLabels } from "../utils/ui-labels";
import { FACE_BY_SLUG, FACE_ORDER } from "../utils/nav";

interface Props {
	/** true on Quiénes somos / About us: no self-link */
	selfPage?: boolean;
}
const { selfPage = false } = Astro.props;

const locale = Astro.currentLocale || "es";
const labels = await getUiLabels(locale);
const en = locale === "en";
const beats = [
	labels.get("mantra", "beat_1", en ? "One team" : "Un equipo"),
	labels.get("mantra", "beat_2", en ? "Six verticals" : "Seis verticales"),
	labels.get("mantra", "beat_3", en ? "Promise kept" : "Dicho y hecho"),
];
const href = en ? "/en/about-us" : "/quienes-somos";

// the six faces come from the CMS in canonical cube order, and each one
// LINKS to its vertical — the glyph is navigation, not decoration
const { entries: serviceEntries } = await getEmDashCollection("services", {
	orderBy: { created_at: "asc" },
	locale,
});
const faces = (serviceEntries ?? [])
	.map((s: any) => {
		const slug = s.slug ?? s.id;
		return {
			key: FACE_BY_SLUG[slug],
			href: `${en ? "/en" : ""}/${slug}`,
			title: s.data.title ?? slug,
			color: s.data.color ?? "#1E1E1E",
		};
	})
	.filter((f) => f.key)
	.sort((a, b) => FACE_ORDER.indexOf(a.key) - FACE_ORDER.indexOf(b.key));
// the figure carries the number, so the noun drops its quantifier; the
// closing beat has no figure — ∎ stands in front of it
const nouns = beats.map((b) => b.replace(/^(Un |One |Seis |Six )/, ""));
---

<aside class="mantra">
	<p class="mantra__eq">
		{/* three beats, each a unit the line never breaks inside: it wraps
		    between them, the arrow leading the next */}
		<span class="mantra__step">
			<span class="mantra__cube-wrap" aria-hidden="true">
				<svg class="mantra__cube" width="21" height="24" viewBox="0 0 200 228" role="presentation">
					<polygon points="100,14 186,64 100,114 14,64" fill="#CED4DA"></polygon>
					<polygon points="14,64 100,114 100,214 14,164" fill="#CED4DA"></polygon>
					<polygon points="100,114 186,64 186,164 100,214" fill="#E3E7EB"></polygon>
					<path d="M100,14 186,64 186,164 100,214 14,164 14,64 Z"></path>
					<path d="M14,64 100,114 186,64 M100,114 100,214"></path>
					<path d="M57,39 143,89 M143,39 57,89"></path>
					<path d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114"></path>
				</svg>
			</span>
			<span class="mantra__n">1</span>
			{selfPage ? <span>{nouns[0]}</span> : <a href={href}>{nouns[0]}</a>}
			<span class="u-sr">. </span>
		</span>
		<span class="mantra__step">
			<b class="mantra__to" aria-hidden="true"></b>
			<span class="mantra__cells" aria-hidden="true"
				><span class="mantra__cells-grid">
					{faces.map((f) => <i style={`background:${f.color}`} title={f.title}></i>)}
				</span></span
			>
			<span class="mantra__n">6</span>
			<span>{nouns[1]}</span>
			<span class="u-sr">. </span>
		</span>
		<span class="mantra__step">
			<b class="mantra__to" aria-hidden="true"></b>
			<span class="mantra__qed" aria-hidden="true"></span>
			<span class="mantra__beat">{nouns[2]}</span>
			<span class="u-sr">.</span>
		</span>
	</p>
</aside>

<script>
	// Give the mantra its face as it approaches (see `.mantra.is-near`). No
	// observer, no wait: the face is applied at once.
	const mantras = document.querySelectorAll<HTMLElement>(".mantra");
	if (!("IntersectionObserver" in window)) mantras.forEach((m) => m.classList.add("is-near"));
	else {
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				e.target.classList.add("is-near");
				io.unobserve(e.target);
			}
		}, { rootMargin: "150% 0px" });
		mantras.forEach((m) => io.observe(m));
	}
</script>

<style is:global>
	/* the house box: left rule + 4% ink tint, same pattern and rhythm as
	   .s-partner (service.css) — the signature sits inside it instead of
	   floating naked against the next band (founder review) */
	.mantra {
		/* one width for every statement block: the text measure (#304) */
		max-width: var(--measure-statement);
		/* no top margin: the gap above is the previous section's bottom
		   padding, like every other section boundary (§14 rhythm) */
		margin: 0;
		padding: var(--space-4) var(--space-5) var(--space-5);
		border-left: var(--block-rule) solid var(--color-primary, #1e1e1e);
		background: var(--color-tint);
	}

	/* The face arrives with the mantra, not with the page (#568). Declared
	   up front, the three Computer Modern cuts were requested while the
	   first screen loaded, and Lighthouse's simulation charged them to every
	   page's LCP — the mantra sits at the page's foot. The text is the same
	   from the start, laid out in the fallback serif; the script below gives
	   it its face once it is within a screen and a half of the viewport. */
	/* one line that wraps between beats, never inside the glyphs: a flex
	   row, so the whitespace compressHTML strips between elements does not
	   matter — the gaps are the margins below */
	.mantra__eq {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		row-gap: var(--space-1);
		margin: 0;
		font-family: "Latin Modern Roman", "Times New Roman", serif;
		font-size: 27px;
		line-height: 40px;
		font-weight: 400;
		font-style: italic;
		color: var(--color-primary, #1e1e1e);
	}

	.mantra.is-near .mantra__eq {
		font-family: "CMU Serif", "CM Proof Symbols", "Latin Modern Roman", "Times New Roman", serif;
	}

	.mantra__step {
		display: inline-flex;
		align-items: baseline;
		white-space: nowrap;
	}

	.mantra__n {
		margin-right: .25em;
		font-style: normal;
		font-weight: 700;
		font-size: 31px;
	}

	/* → and ∎ are drawn by CSS, not written in the DOM: they are not
	   language, and the copy baseline freezes language (#453's rule for the
	   area rows' arrow) */
	.mantra__to::before { content: "→"; }
	.mantra__qed::before { content: "∎"; }

	/* the steps between beats: upright, light, at the line's own size */
	.mantra__to {
		padding: 0 .45em;
		font-style: normal;
		font-weight: 400;
		color: var(--color-text-muted);
	}

	/* ∎, in ink: the six coloured squares and this one rhyme */
	.mantra__qed {
		margin-right: .35em;
		font-style: normal;
		color: var(--color-primary, #1e1e1e);
	}

	/* the closing beat reads as the other two do, lowercase — in the CMS it
	   keeps its capital (presentation only, §14) */
	.mantra__beat {
		text-transform: lowercase;
	}

	/* The six faces ride IN FRONT of the figure, in one row (#579), and SIT
	   on the text baseline (founder, #295: "no quiero que bailen"). The
	   wrapper is an item of the step's baseline-aligned flex row and holds no
	   text, so its baseline is synthesised from its bottom edge: the squares
	   stand on the line, measured at 1440 and 360 px. */
	.mantra__cells {
		display: inline-block;
		overflow: hidden;
		vertical-align: baseline;
		line-height: 0;
		margin-right: var(--space-2);
	}
	.mantra__cells-grid {
		display: flex;
		gap: 2px;
	}
	.mantra__cells i {
		display: block;
		width: .3em;
		height: .3em;
	}

	/* ink edges over grey faces — the mark reads at 21px only if the strokes
	   carry it (founder review: the first cut had no legible edges) */
	.mantra__cube path {
		fill: none;
		stroke: var(--color-primary, #1e1e1e);
		stroke-width: 13;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.mantra__cube-wrap {
		display: inline-block;
		margin-right: var(--space-2);
		vertical-align: baseline;
		overflow: hidden;
		line-height: 0;
	}


	.mantra a {
		color: inherit;
		text-decoration: underline;
		text-decoration-style: dashed;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
		text-decoration-color: color-mix(in srgb, currentColor 50%, transparent);
	}
	.mantra a:hover,
	.mantra a:focus-visible {
		text-decoration-style: solid;
		text-decoration-color: currentColor;
	}

	.u-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 700px) {
		.mantra { padding: var(--space-3) var(--space-4) var(--space-4); }
		.mantra__eq { font-size: 20px; line-height: 34px; }
		.mantra__n { font-size: 23px; }
		.mantra__cube { width: 17px; height: 19px; }
		/* the wrapper is `overflow: hidden` and shrink-wraps — it never
		   carries a width, or it clips the faces on a phone */
		.mantra__cells-grid { gap: 1px; }
	}
</style>
