---
/**
 * MantraCloser — the house signature, one implementation (#295).
 *
 * The line used to be written 14 times across the content and each page
 * gave it its own shape (standout blockquote, quiet blockquote, plain
 * paragraph, inline bold mid-sentence). Now the three beats live once per
 * locale in the CMS (ui_labels → mantra) and this component gives them
 * their form, so a new page cannot drift. Same move as the heading mark
 * in #298: what is design leaves the copy.
 *
 * The form is an equation set in Computer Modern — Knuth's TeX face,
 * self-hosted and subset to these glyphs (13 KB for three cuts). The "6"
 * is not written: it is SHOWN as the six vertical colors, the canonical
 * ones from the menu die, the section emblems and the home rows. Screen
 * readers get the numeral instead (`u-sr`).
 *
 * The rule is ink everywhere (the logo's palette): the only color in the
 * piece is the six faces, and there it means something.
 */
import { getUiLabels } from "../utils/ui-labels";

interface Props {
	/** true on Quiénes somos / About us: no self-link */
	selfPage?: boolean;
}
const { selfPage = false } = Astro.props;

const locale = Astro.currentLocale || "es";
const labels = await getUiLabels(locale);
const en = locale === "en";
const beats = [
	labels.get("mantra", "beat_1", en ? "One team" : "Un equipo"),
	labels.get("mantra", "beat_2", en ? "Six verticals" : "Seis verticales"),
	labels.get("mantra", "beat_3", en ? "Zero handoffs" : "Cero traspasos"),
];
const href = en ? "/en/about-us" : "/quienes-somos";

// canonical vertical colors, cube order (ec · int · bd · cdn · gf · ia)
const FACE_COLORS = ["#008FD3", "#1D4E89", "#EA4335", "#F38020", "#3E7D50", "#6B4FBB"];
// the noun without its quantifier: the figure carries the number
const nouns = beats.map((b) => b.replace(/^(Un |One |Seis |Six |Cero |Zero )/, ""));
---

<aside class="mantra">
	<p class="mantra__eq">
		<span class="mantra__n">1</span>{" "}
		{selfPage ? nouns[0] : <a href={href}>{nouns[0]}</a>} <b>=</b>
		<span class="mantra__six">
			<span class="mantra__cells" aria-hidden="true">
				{FACE_COLORS.map((c) => <i style={`background:${c}`}></i>)}
			</span>
			<span class="u-sr">6</span>
		</span>{" "}
		{nouns[1]} <b>=</b>
		<span class="mantra__n">0</span> {nouns[2]}
	</p>
</aside>

<style is:global>
	.mantra {
		max-width: 700px;
		margin: 40px 0 0;
		border-left: 3px solid var(--color-primary, #1e1e1e);
		padding-left: 18px;
	}

	.mantra__eq {
		margin: 0;
		font-family: "CMU Serif", "Latin Modern Roman", "Times New Roman", serif;
		font-size: 27px;
		line-height: 40px;
		font-weight: 400;
		font-style: italic;
		color: var(--color-primary, #1e1e1e);
	}

	.mantra__n {
		font-style: normal;
		font-weight: 700;
		font-size: 31px;
	}

	.mantra__eq b {
		font-style: normal;
		font-weight: 400;
		padding: 0 6px;
		color: color-mix(in srgb, var(--color-primary, #1e1e1e) 45%, transparent);
	}

	.mantra a {
		color: inherit;
		text-decoration: underline;
		text-decoration-style: dashed;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
		text-decoration-color: color-mix(in srgb, currentColor 50%, transparent);
	}
	.mantra a:hover,
	.mantra a:focus-visible {
		text-decoration-style: solid;
		text-decoration-color: currentColor;
	}

	/* the six faces stand in for the numeral: one row, sat on the baseline
	   like a glyph (the 3x2 block hung below the line — founder review) */
	.mantra__six {
		display: inline-block;
	}
	.mantra__cells {
		display: inline-grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 2px;
		width: 48px;
		vertical-align: baseline;
		position: relative;
		top: 1px;
	}
	.mantra__cells i {
		aspect-ratio: 1;
	}

	.u-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 700px) {
		.mantra__eq { font-size: 21px; line-height: 33px; }
		.mantra__n { font-size: 24px; }
		.mantra__cells { width: 38px; }
	}
</style>
