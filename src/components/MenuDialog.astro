---
/**
 * MenuDialog — list + living logo (#211 v29, #231; supersedes the sheet).
 *
 * A traditional menu that drives the die: specialties in large type with
 * colored 2×2 mini-face bullets, one quiet line of site links below, and
 * the logo-as-die on the right reacting to every hover/focus. Labels and
 * colors come from the CMS; the die is decorative (aria-hidden).
 *
 * Dialog contract (ids, open/close classes) is unchanged — Base's script
 * keeps driving it.
 */
import LogoDie from "./LogoDie.astro";
import SearchPrompt from "./SearchPrompt.astro";
import { FACE_BY_SLUG, FACE_ORDER, SITE_BY_PATH } from "../utils/nav";
import { getUiLabels } from "../utils/ui-labels";

interface ServiceEntry {
	id: string;
	slug?: string;
	data: { title?: string; color?: string };
}
interface MenuItem {
	url?: string;
	label?: string;
}
interface Props {
	services: ServiceEntry[];
	siteItems: MenuItem[];
	currentPath: string;
	localePrefix: string;
}
const { services, siteItems, currentPath, localePrefix } = Astro.props;
const t = Astro.locals.t;

/* A phone is 390px wide and "cdn, waf y seguridad edge" is not. It wrapped to
   two lines, and a two-line item in a six-item menu reads as a mistake
   (founder, 2026-08-28: "no quiero saltos de línea en un menú tan básico").
   So each vertical carries a short name too, keyed by its face, and the panel
   ships BOTH: CSS shows the long one from 701px up and the short one below.
   Not JS measuring the box — the answer must not depend on which text happens
   to be there, and a menu has to be right on the first paint. */
const short = (await getUiLabels(Astro.currentLocale || "es")).getAll("menu_short");

const activeFace = FACE_BY_SLUG[currentPath.replace(/^\/en/, "").replace(/^\//, "")] ?? null;
const activeSite = SITE_BY_PATH[currentPath] ?? null;

const specLinks = services
	.map((s) => {
		const slug = s.slug ?? s.id;
		const key = FACE_BY_SLUG[slug];
		const title = s.data.title ?? slug;
		return {
			key,
			href: `${localePrefix}/${slug}`,
			title,
			// no short name in the CMS = the long one, never an empty link
			short: short[key] || title,
			color: s.data.color ?? "#1E1E1E",
		};
	})
	.filter((l) => l.key)
	.sort((a, b) => FACE_ORDER.indexOf(a.key) - FACE_ORDER.indexOf(b.key));

/* Direction B paints a 6px edge down the left in the colour of the vertical
   you opened the menu from — the one thing on the panel that says which page
   is underneath. Off every other page there is no such colour, and an
   arbitrary one would be a lie, so the edge simply is not painted. */
const activeColor = specLinks.find((l) => l.key === activeFace)?.color ?? null;

const siteLinks = siteItems
	.map((it) => ({
		key: SITE_BY_PATH[it.url ?? ""],
		href: it.url ?? "#",
		title: it.label ?? "",
	}))
	.filter((l) => l.key);

/* The bar's mark goes home. Taken from the CMS's own site list rather than
   hardcoded, so it follows the locale the same way the entry below it does;
   if the list has no home item the bar falls back to being a picture, which
   is what it was before — a dead `href="/"` would be worse than no link. */
const homeLink = siteLinks.find((l) => l.key === "home") ?? null;
---

<div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>
<dialog
	class="menu-dialog"
	id="menu-dialog"
	aria-label={t("main_menu")}
	style={activeColor ? `--menu-edge:${activeColor}` : undefined}
>
	<button
		type="button"
		class="menu-close"
		id="menu-close"
		aria-label={t("close_menu")}
	>✕</button>

	{/* The panel keeps the site's header line instead of replacing the page
	    with a blank sheet (#417). It was a PICTURE of the bar — aria-hidden,
	    no links — so a second copy of the header's controls would not add tab
	    stops inside a dialog whose keyboard trap the a11y gate measures.

	    The founder tried to click it (2026-08-28: "en el menú, las migas de
	    arriba no funciona el enlace y no puedo ir a la home"), which is the
	    only verdict that matters: a wordmark at the top left of a panel is a
	    way home in every site anyone has ever used, and drawing one that is
	    not is a trap. The MARK is a real link now; the breadcrumb beside it
	    stays plain text, because it names where you already are. One extra
	    tab stop, first inside the dialog, which is where a home link belongs.

	    The language switcher is still absent — that one really would be a
	    duplicate control with no unique destination. */}
	<div class="menu-bar">
		<div class="menu-bar__inner">
			{homeLink ? (
				<a class="menu-bar__home" href={homeLink.href}>
					<svg class="menu-bar__cube" width="30" height="34" viewBox="0 0 200 228" fill="none" aria-hidden="true">
						<path class="menu-bar__edge" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z"></path>
						<path class="menu-bar__edge" d="M14,64 100,114 186,64 M100,114 100,214"></path>
						<path class="menu-bar__edge menu-bar__edge--hair" d="M57,39 143,89 M143,39 57,89"></path>
						<path class="menu-bar__edge menu-bar__edge--hair" d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114"></path>
					</svg>
					<span class="menu-bar__word">~Server Startup</span>
				</a>
			) : (
				<span class="menu-bar__home" aria-hidden="true">
					<svg class="menu-bar__cube" width="30" height="34" viewBox="0 0 200 228" fill="none">
						<path class="menu-bar__edge" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z"></path>
						<path class="menu-bar__edge" d="M14,64 100,114 186,64 M100,114 100,214"></path>
						<path class="menu-bar__edge menu-bar__edge--hair" d="M57,39 143,89 M143,39 57,89"></path>
						<path class="menu-bar__edge menu-bar__edge--hair" d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114"></path>
					</svg>
					<span class="menu-bar__word">~Server Startup</span>
				</span>
			)}
			{currentPath && <span class="menu-bar__path">{currentPath}</span>}
		</div>
	</div>

	<div class="menu-inner">
		{/* #338: on phones the header has no room for the command line, so the
		    menu carries it — full-screen, and the cube is still the only door. */}
		{/* Ink, not the console's green: on paper the prompt glyph is TEXT on
		    a light ground, and #5BB974 measures 2.4:1 there. The header's own
		    console already answers this — its accent is the section colour on
		    a coloured page and ink everywhere else, and this panel is the
		    phone's copy of that line, so it takes the quiet end of it. */}
		<SearchPrompt pathname={currentPath} accent="var(--color-primary)" place="menu" />
		<div class="menu-lists">
			<nav aria-label={t("nav_specialties")}>
				<p class="menu-kicker">{t("menu_kicker")}</p>
				<ul class="menu-spec" role="list">
					{specLinks.map((l) => (
						<li>
							<a
								href={l.href}
								class="spec-link"
								style={`--fc:${l.color}`}
								data-die-spec={l.key}
								aria-current={l.key === activeFace ? "page" : undefined}
							>
								<span class="spec-mini" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
								<span class="spec-title spec-title--long">{l.title}</span>
								<span class="spec-title spec-title--short">{l.short}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
		{/* Out of the 1fr column and across the whole panel. Inside it the row had
		    534px to seat five Spanish labels that measure 605 with their gaps, and
		    it had been within a pixel of wrapping since #431 — "Deconstruyendo"
		    dropped to a line of its own the moment the labels stopped being
		    lowercased. Tuning the gap would have bought the 13px this particular
		    wording needs and left the next label to break it again; the row simply
		    is not a thing that belongs in the narrow column. Document order is
		    unchanged — it still reads after the specialties and before the die. */}
		<nav class="menu-site-nav" aria-label={t("nav_site")}>
			<ul class="menu-site" role="list">
				{siteLinks.map((l) => (
					<li>
						<a
							href={l.href}
							class="site-link"
							data-die-site={l.key}
							aria-current={l.key === activeSite ? "page" : undefined}
						>{l.title}</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="menu-die">
			<LogoDie services={services} currentPath={currentPath} />
			<p class="die-hint" aria-hidden="true">{t("die_hint")}</p>
		</div>
	</div>
</dialog>

<style is:global>
	/* ═══════════════════════════════════════════
	   MENU DIALOG — list + living logo
	   ═══════════════════════════════════════════ */
	.menu-backdrop {
		position: fixed;
		inset: 0;
		background: var(--color-scrim);
		z-index: 199;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s;
	}
	.menu-backdrop.is-open { opacity: 1; pointer-events: auto; }

	.menu-dialog {
		position: fixed;
		top: 0;
		right: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		/* #431: paper, flat — the same ground as the page it covers. #417's
		   ink-plus-cube-field is gone; what tells you a layer opened is the
		   strip below, the ✕, and the fact that the page went away. A drawing
		   behind a menu is a picture competing with a list of six links. */
		background: var(--color-secondary);
		border: none;
		z-index: 200;
		transform: translateX(100%);
		transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		overflow-y: auto;
		padding: 0;
		margin: 0;
	}
	.menu-dialog::backdrop { background: transparent; }
	/* A pseudo-element, not a border: the dialog is exactly 100vw and a 6px
	   border would push it past the viewport. Fixed, so it survives the
	   panel's own scroll — the transform above is its containing block. */
	.menu-dialog::before {
		content: "";
		position: fixed;
		left: 0;
		top: 0;
		bottom: 0;
		width: 6px;
		background: var(--menu-edge, transparent);
		z-index: 202;
	}
	.menu-dialog.is-open { transform: translateX(0); }

	.menu-close {
		position: fixed;
		/* centred in the 76px strip, in a 44px box — the WCAG 2.5.8 target */
		top: 16px;
		right: 24px;
		width: 44px;
		height: 44px;
		z-index: 203;
		background: none;
		border: none;
		font-size: 32px;
		cursor: pointer;
		color: var(--menu-ink);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* ── The strip: the header line, kept ── */
	.menu-bar {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		height: 76px;
		z-index: 202;
		display: flex;
		align-items: center;
		border-bottom: 1px solid var(--menu-rule);
	}
	.menu-bar__inner {
		max-width: var(--container-max);
		width: 100%;
		margin: 0 auto;
		padding: 0 24px 0 30px;
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
	}
	.menu-bar__home {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		color: inherit;
	}
	.menu-bar__home:focus-visible {
		outline: 2px solid var(--menu-ink);
		outline-offset: 4px;
	}
	a.menu-bar__home:hover .menu-bar__word {
		/* the same terminal selection the breadcrumb and the search slot wear */
		background-color: var(--menu-tint);
	}
	.menu-bar__cube { flex: none; }
	.menu-bar__edge {
		fill: none;
		stroke: var(--menu-ink);
		stroke-width: 13;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.menu-bar__edge--hair {
		stroke-width: 8;
		opacity: 0.5;
	}
	.menu-bar__word,
	.menu-bar__path {
		font-family: var(--font-family-mono);
		font-size: 0.95rem;
		white-space: nowrap;
	}
	.menu-bar__word {
		font-weight: 700;
		color: var(--menu-ink);
	}
	.menu-bar__path {
		font-weight: 500;
		color: var(--menu-ink-soft);
		background: var(--menu-tint);
		border-radius: var(--radius);
		padding-inline: 4px;
		overflow: hidden;
		text-overflow: ellipsis;
		/* token-guard: off — truncation, not a measure: the same clamp the
		   header's breadcrumb wears, so the strip never wraps. */
		max-width: 34vw;
		/* token-guard: on */
	}

	.menu-kicker {
		margin: 0 0 18px;
		padding-left: 10px;
		font-family: var(--font-family-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		color: var(--menu-ink-muted);
	}

	/* Measured before touching it, at 1440x900 on a vertical page: the list is
	   458px tall, and `align-items: center` inside `min-height: 100vh` left
	   169px of empty paper between the strip and the first link and 197px
	   below the last — 41% of the viewport, none of it doing anything. The
	   space above is the half that hurts: it pushes the first specialty a
	   third of the way down a screen the reader just asked to be shown.

	   So the content is anchored under the strip and the air is spent, not
	   left over: the console moves in above the list (it was the phone's
	   privilege only, see the `--menu` rules in SiteHeader), and the rows grow
	   to a 72px target. `align-items: start` is what stops the re-centring;
	   the die is put back on the middle of the column it sits beside with an
	   explicit `grid-row`, which it needs anyway now that a third child
	   exists — auto-placement would otherwise fill row 1 with the console and
	   the list and push the die underneath. */
	.menu-inner {
		max-width: var(--container-max);
		margin: 0 auto;
		/* 76px of fixed strip plus air; the strip is `position: fixed`, so this
		   padding is the only thing keeping the console out from under it. */
		padding: 108px 24px var(--space-5);
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 48px;
		row-gap: var(--space-4);
		align-items: start;
		min-height: 100vh;
	}
	/* Every placement is explicit, and `span 2` is load-bearing: `1 / -1`
	   counts to the end of the EXPLICIT grid, and this grid declares columns
	   only. With no explicit rows, `-1` resolves back to line 1, the die keeps
	   row 1 to itself, and row 1 becomes 230px tall — which pushed the list
	   down to y=362 and the panel 120px past the fold. Measured, not reasoned:
	   the first draft of this rule did exactly that. */
	.menu-inner > .search-form--menu {
		grid-column: 1;
		grid-row: 1;
	}
	.menu-lists {
		grid-column: 1;
		grid-row: 2;
	}
	.menu-site-nav {
		grid-column: 1 / span 2;
		grid-row: 3;
	}
	.menu-die {
		grid-column: 2;
		grid-row: 1 / span 2;
		align-self: center;
	}

	.menu-spec {
		display: flex;
		flex-direction: column;
		gap: 4px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.spec-link {
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 32px;
		font-weight: 650;
		line-height: 1.25;
		color: var(--menu-ink);
		text-decoration: none;
		/* 16px, not 8: six rows are what the panel is for, and the height the
		   centring used to waste is theirs. It also takes the row past the 44px
		   WCAG 2.5.8 target with room to spare, which 8px did only because the
		   type is 32px. */
		padding: var(--space-3) 10px;
		transition: background 0.15s;
	}
	/* The rows breathe where there is height to breathe into and go back to
	   compact where there is not. A 1280x800 laptop is the case that decides
	   it: at 72px rows the panel needs 806px and grows a scrollbar, at 56px it
	   needs 710px and does not. Height, not width — the defect this fixes is
	   vertical, and asking about the viewport's width to answer it is how the
	   panel came to centre 458px of list in 900px in the first place. */
	@media (max-height: 860px) {
		.spec-link { padding: var(--space-2) 10px; }
	}

	/* The tint is the face colour mixed toward the ground, which is what an
	   alpha does. On paper that lands on the site's own pastel card palette
	   — the same wash the service cards wear — without a second list of six
	   colours to keep in sync with the CMS. */
	.spec-link:hover,
	.spec-link:focus-visible {
		background: color-mix(in srgb, var(--fc, var(--color-primary)) 16%, transparent);
	}
	.spec-link[aria-current="page"] {
		background: color-mix(in srgb, var(--fc, var(--color-primary)) 24%, transparent);
	}
	.spec-mini {
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 2px;
		width: 26px;
		height: 26px;
		/* the CMS hue, raw: these six were drawn for paper and this is paper */
		border: 2px solid var(--fc, var(--color-primary));
		padding: 2px;
		flex: none;
	}
	.spec-mini i {
		background: var(--fc, var(--color-primary));
		opacity: 0.28;
	}
	.spec-link[aria-current="page"] .spec-mini i { opacity: 1; }

	.menu-site {
		margin: 22px 0 0;
		padding: 16px 10px 0;
		/* a hairline, not a dash: the site separates with `--color-border`
		   everywhere else, and a dashed rule is a texture, not a boundary */
		border-top: 1px solid var(--menu-rule);
		display: flex;
		flex-wrap: wrap;
		gap: 12px 20px;
		list-style: none;
	}
	/* The navigation labels are CMS CONTENT and render as stored. Lowercasing
	   them was the panel's own invention: it printed "comercio electrónico"
	   over a title the editor wrote as "Comercio electrónico", so the menu
	   disagreed with the page it opens, with the breadcrumb below it, and with
	   the CMS field itself — and no editor could fix it from the admin.

	   The device is not gone, it is scoped. Everywhere lowercase survives on
	   this site it dresses the same object: a mono eyebrow at 11-13px with
	   0.06-0.08em tracking in a muted ink — `.menu-kicker` and `.die-hint`
	   here, `.footer-partner-title`, `.ref-banner__title`, `.nf-pieces p`
	   elsewhere. Those are chrome the house writes. A 32px sans link carrying
	   a name from the database is not, and it was the only one of the six
	   breaking the rule. */
	/* "cdn, waf y seguridad edge" does not fit a 390px phone, and a wrapped
	   item in a six-item menu reads as a mistake (founder, 2026-08-28: "no
	   quiero saltos de línea en un menú tan básico"). Both names ship and the
	   breakpoint picks one — not JS measuring the box, because the menu has to
	   be right on the first paint and the answer must not depend on which
	   text happens to be there. The two spans are why `nowrap` is safe: the
	   short one is chosen precisely where the long one would break. */
	.spec-title--short { display: none; }
	.spec-title { white-space: nowrap; }

	.site-link {
		font-size: 16px;
		font-weight: 500;
		color: var(--menu-ink-muted);
		text-decoration: none;
		flex: none;
	}
	.site-link:hover,
	.site-link:focus-visible,
	.site-link[aria-current="page"] {
		color: var(--menu-ink);
	}
	/* The specialty rows say where you are four ways over — the tint, the
	   filled mini-face, the die landing on that face, and the 6px edge down
	   the panel. This row had one: it went from #6B6B6B to #1E1E1E, which is
	   exactly what hovering any OTHER item does, so "current" and "the one
	   under the pointer" were the same picture and 1.4.1 had nothing but
	   colour to go on. The chip is the strip's own device — `.menu-bar__path`
	   wears it over the path you are on — and it survives being read in one
	   ink. Padding is on the rest state too, so marking a row moves nothing. */
	.site-link {
		border-radius: var(--radius);
		/* The chip needs room to sit around the text, and the row cannot afford
		   it: five links plus 60px of new padding wrapped "Deconstruyendo" onto
		   a line of its own the first time this was tried — the same orphan G4
		   refuses down in the reference strip. The negative margin gives the
		   width straight back, so the margin box is the size it always was and
		   the row cannot wrap because of this rule. The visible gap between two
		   labels is unchanged: 20px of flex gap becomes 8px plus the 6px each
		   chip now carries. */
		padding-inline: 6px;
		margin-inline: -6px;
	}
	.site-link[aria-current="page"] {
		background: var(--menu-tint);
	}

	/* The grid item must be allowed to shrink below its content's automatic
	   minimum — the nowrap site row otherwise inflates the 1fr track past
	   the viewport and the whole menu clips (#236). */
	.menu-lists {
		min-width: 0;
	}

	.menu-die {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.die-hint {
		display: none;
		font-family: var(--font-family-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: lowercase;
		color: var(--menu-ink-muted);
		margin: 0;
		text-align: center;
	}

	/* ── The die ──
	   Nothing to override, and that is the point twice over. #417 repainted
	   the resting die for its ink ground and the founder rejected it
	   (2026-08-28: "el cuadrado cuando está quieto no tiene los colores
	   originales del logo. Eso tiene que quedar clavado!! es mi marca"); what
	   survived was a lightness floor on the ROLLED faces, because three of the
	   CMS's six hues do not exist on ink. On paper they do. The mark and the
	   roll are both LogoDie's own colours here, unqualified.

	   And the plates finally read: stacked on ink, only the light one showed
	   and the dark one was a hole. */

	/* The die highlights the specialty it lands on when rolled by tap */
	.spec-link.rolled {
		background: color-mix(in srgb, var(--fc, var(--color-primary)) 16%, transparent);
	}

	/* tablet: the approved composition, compressed — die at ×0.85 with air */
	@media (min-width: 701px) and (max-width: 1100px) {
		.menu-inner {
			column-gap: 28px;
			padding-inline: 40px;
		}
		.logo-stage { transform: scale(0.85); margin: -14px 0; }
		.menu-die { padding-right: 6px; }
		.die-hint { display: block; }
	}

	/* mobile: the die opens the menu — compass position, tap to roll.
	   Site links stack vertically (wrapped rows read as clutter and the
	   last row died half-cut at the viewport edge). */
	@media (max-width: 700px) {
		.spec-title--long { display: none; }
		.spec-title--short { display: inline; }
		.menu-bar { height: 60px; }
		.menu-bar__inner { padding: 0 16px 0 22px; gap: 8px; }
		.menu-bar__cube { width: 24px; height: 27px; }
		.menu-bar__word,
		.menu-bar__path { font-size: 0.8rem; }
		.menu-close {
			top: 8px;
