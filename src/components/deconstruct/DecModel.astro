---
/**
 * The map that opens /deconstruyendo (#535): the whole site as one isometric
 * drawing. The four Cloudflare layers stacked in the middle, EmDash above
 * them and the page below, content and delivery as the two tiles behind,
 * quality around everything. Geometry is Claude Design's (delivery «B mapa
 * v5»); every word comes from the `layers` collection or the
 * `deconstruct_labels` widget. Each piece links to its plate, and the plate
 * on screen lights its piece (script in DeconstructPage.astro).
 */
import type { Layer } from "../../utils/layers";
import { CLOUDFLARE_PRODUCTS, layerHtml } from "../../utils/layers";
import type { UiLabels } from "../../utils/ui-labels";

interface Props {
	layers: Layer[];
	labels: UiLabels;
}
const { layers, labels } = Astro.props;
const L = (k: string, fb: string) => labels.get("deconstruct_labels", k, fb);
const by = Object.fromEntries(layers.map((l) => [l.figure, l]));
const href = (f: string) => (by[f] ? `#${by[f].slug}` : undefined);

/** markdown-lite → SVG text runs: `code` becomes a tspan, orange when it names a Cloudflare product. */
function runs(s: string | undefined): { text: string; cf: boolean }[] {
	if (!s) return [];
	const out: { text: string; cf: boolean }[] = [];
	for (const part of s.replace(/\*([^*]+)\*/g, "$1").split(/(`[^`]+`)/)) {
		if (!part) continue;
		const code = part.startsWith("`") && part.endsWith("`");
		const text = code ? part.slice(1, -1) : part;
		out.push({ text, cf: code && CLOUDFLARE_PRODUCTS.has(text) });
	}
	return out;
}

/** A title without its markdown-lite code marks, for SVG text and aria-labels. */
const plain = (s: string) => s.replaceAll("\u0060", "");

const SLABS = [
	{ f: "datos", s: "s1", n: "04", ft: "600.0,596.5 799.7,711.8 600.0,827.1 400.3,711.8", fl: "400.3,711.8 600.0,827.1 600.0,879.5 400.3,764.2", fr: "600.0,827.1 799.7,711.8 799.7,764.2 600.0,879.5", ln: "M500.2,769.4 V821.9 M699.8,769.4 V821.9", et: "matrix(1,0.577,0,1,450.2,766.8)" },
	{ f: "computo", s: "s2", n: "03", ft: "600.0,537.8 799.7,653.1 600.0,768.4 400.3,653.1", fl: "400.3,653.1 600.0,768.4 600.0,820.8 400.3,705.6", fr: "600.0,768.4 799.7,653.1 799.7,705.6 600.0,820.8", ln: "M500.2,710.8 V763.2 M699.8,710.8 V763.2", et: "matrix(1,0.577,0,1,450.2,708.2)" },
	{ f: "cache", s: "s3", n: "02", ft: "600.0,479.2 799.7,594.4 600.0,709.7 400.3,594.4", fl: "400.3,594.4 600.0,709.7 600.0,762.2 400.3,646.9", fr: "600.0,709.7 799.7,594.4 799.7,646.9 600.0,762.2", ln: "M500.2,652.1 V704.5 M699.8,652.1 V704.5", et: "matrix(1,0.577,0,1,450.2,649.5)" },
	{ f: "red", s: "s4", n: "01", ft: "600.0,420.5 799.7,535.8 600.0,651.0 400.3,535.8", fl: "400.3,535.8 600.0,651.0 600.0,703.5 400.3,588.2", fr: "600.0,651.0 799.7,535.8 799.7,588.2 600.0,703.5", ln: "M500.2,593.4 V645.8 M699.8,593.4 V645.8 M500.2,478.1 L699.8,593.4 M699.8,478.1 L500.2,593.4", et: "matrix(1,0.577,0,1,450.2,590.8)" },
];
/* the labels on the right, top to bottom, as the slabs stack: the network on top, the data at the base
   (founder, 2026-10-20: "la primera la red, y abajo los datos") */
const RIGHT = [
	{ f: "red", y: 536.0 },
	{ f: "cache", y: 594.7 },
	{ f: "computo", y: 653.3 },
	{ f: "datos", y: 712.0 },
];
const SM = [
	{ s: "s1", ft: "156.0,125.8 246.6,178.1 156.0,230.4 65.4,178.1", fl: "65.4,178.1 156.0,230.4 156.0,254.1 65.4,201.8", fr: "156.0,230.4 246.6,178.1 246.6,201.8 156.0,254.1", ln: "M110.7,204.2 V228.0 M201.3,204.2 V228.0" },
	{ s: "s2", ft: "156.0,99.1 246.6,151.4 156.0,203.7 65.4,151.4", fl: "65.4,151.4 156.0,203.7 156.0,227.5 65.4,175.2", fr: "156.0,203.7 246.6,151.4 246.6,175.2 156.0,227.5", ln: "M110.7,177.6 V201.4 M201.3,177.6 V201.4" },
	{ s: "s3", ft: "156.0,72.5 246.6,124.8 156.0,177.1 65.4,124.8", fl: "65.4,124.8 156.0,177.1 156.0,200.9 65.4,148.6", fr: "156.0,177.1 246.6,124.8 246.6,148.6 156.0,200.9", ln: "M110.7,151.0 V174.7 M201.3,151.0 V174.7" },
	{ s: "s4", ft: "156.0,45.9 246.6,98.2 156.0,150.5 65.4,98.2", fl: "65.4,98.2 156.0,150.5 156.0,174.2 65.4,121.9", fr: "156.0,150.5 246.6,98.2 246.6,121.9 156.0,174.2", ln: "M110.7,124.3 V148.1 M201.3,124.3 V148.1 M110.7,72.0 L201.3,124.3 M201.3,72.0 L110.7,124.3" },
];
/* the small drawing's legend (phones and tablets): each slab's number on its face and its name on a leader,
   the same reading as the map's right column (founder, 2026-10-20: "no hay ninguna alegoría a las capas") */
const SM_LEGEND = [
	{ f: "red", y: 110.0, et: "matrix(1,0.577,0,1,88.1,123.1)", n: "01" },
	{ f: "cache", y: 136.7, et: "matrix(1,0.577,0,1,88.1,149.8)", n: "02" },
	{ f: "computo", y: 163.3, et: "matrix(1,0.577,0,1,88.1,176.4)", n: "03" },
	{ f: "datos", y: 190.0, et: "matrix(1,0.577,0,1,88.1,203.0)", n: "04" },
];
const groups: { key: string; label: string; layers: Layer[] }[] = [
	{ key: "cloudflare", label: L("g_cloudflare", "Cuatro capas, en `Cloudflare`"), layers: layers.filter((l) => l.group === "cloudflare") },
	{ key: "worker", label: L("g_worker", "Dentro del `Worker`"), layers: layers.filter((l) => l.group === "worker") },
	{ key: "taller", label: L("g_taller", "Transversal, desde el taller"), layers: layers.filter((l) => l.group === "taller") },
];
/* the editor's subtitle, two lines split after its colon: on one line it ran past the map's left edge */
const whoSubRaw = L("who_edit_sub", "Server Startup: editor o agente de IA");
const colon = whoSubRaw.indexOf(": ");
const whoSub = colon === -1 ? [whoSubRaw] : [whoSubRaw.slice(0, colon + 1), whoSubRaw.slice(colon + 2)];
const q = by.calidad;
const emd = by.emdash;
const pres = by.presentacion;
const cont = by.contenido;
const entr = by.entrega;
---

<div class="dc-model">
	<div class="dc-model__wrap">
		{/* the windows' screenshots are placed as % of this box, which is the drawing's own: no padding */}
		<div class="dc-model__art">
		<svg class="dc-model__lg" viewBox="-266 308 1674 682" role="group" aria-label={L("map_aria", "")}>
			<defs>
				<marker id="dc-ah" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0,0 L8,4 L0,8 z" class="ahw" /></marker>
			</defs>
			{q && (
				<a class="m-lk w q lb" href={href("calidad")} data-l={q.slug} aria-label={q.short}>
					<path class="qf" d="M102,320 H1388 Q1404,320 1404,336 V969 Q1404,985 1388,985 H-246 Q-262,985 -262,969 V336 Q-262,320 -246,320 H-238" />
					<path class="qhit" d="M-262,320 H1404 V985 H-262 Z" />
					<text class="nm" x="-226" y="328">{q.short}</text>
					<text class="pm" x="-112" y="326">{runs(q.map_note).map((r) => <tspan class={r.cf ? "cf" : undefined}>{r.text}</tspan>)}</text>
				</a>
			)}
			{entr && (
				<a class="m-lk w k" href={href("entrega")} data-l={entr.slug} aria-label={entr.short}>
					<rect class="tb" x="340" y="390" width="520" height="520" rx="46.8" transform="rotate(10 600 650)" />
				</a>
			)}
			{cont && (
				<a class="m-lk w g" href={href("contenido")} data-l={cont.slug} aria-label={cont.short}>
					<rect class="tg" x="340" y="390" width="520" height="520" rx="46.8" />
				</a>
			)}
			{SLABS.map((s) => by[s.f] && (
				<a class="m-lk c" href={href(s.f)} data-l={by[s.f].slug} aria-label={plain(by[s.f].title)}>
					<g class={`sl ${s.s}`}>
						<polygon class="ft" points={s.ft} />
						<polygon class="fl" points={s.fl} />
						<polygon class="fr" points={s.fr} />
						<path class="ln" d={s.ln} />
						<text class="et" transform={s.et} x="0" y="5" text-anchor="middle">{s.n}</text>
					</g>
				</a>
			))}
			<text class="cfl" x="946" y="516.0">{L("cloudflare", "Cloudflare")}</text>
			<line class="br" x1="920" y1="542.0" x2="920" y2="758.0" />
			{RIGHT.map((r) => by[r.f] && (
				<a class="m-lk c lb" href={href(r.f)} data-l={by[r.f].slug} tabindex="-1" aria-hidden="true">
					<rect class="lbh" x="799.7" y={r.y} width="446.3" height="50" />
					<line class="ld" x1="811.7" y1={r.y + 26} x2="910" y2={r.y + 26} />
					<circle class="dt" cx="920" cy={r.y + 26} r="5" />
					<text class="nm" x="946" y={r.y + 27}>{plain(by[r.f].title)}</text>
					<text class="pm" x="946" y={r.y + 47}>{runs(by[r.f].map_note).map((x) => <tspan class={x.cf ? "cf" : undefined}>{x.text}</tspan>)}</text>
				</a>
			))}
			{cont && (
				<a class="m-lk w g lb" href={href("contenido")} data-l={cont.slug} tabindex="-1" aria-hidden="true">
					<rect class="lbh" x="46" y="850" width="316" height="56" />
					<path class="ldw" d="M260,880 H332 L362,880" />
					<circle class="dk" cx="362" cy="880" r="5" />
					<text class="nm" x="250" y="881" text-anchor="end">{cont.short}</text>
					<text class="pm" x="250" y="901" text-anchor="end">{runs(cont.map_note).map((x) => <tspan class={x.cf ? "cf" : undefined}>{x.text}</tspan>)}</text>
				</a>
			)}
			{entr && (
				<a class="m-lk w k lb" href={href("entrega")} data-l={entr.slug} tabindex="-1" aria-hidden="true">
					<rect class="lbh" x="46" y="342" width="370" height="56" />
					<path class="ldw" d="M260,372 H380 L410,372" />
					<circle class="dk" cx="410" cy="372" r="5" />
					<text class="nm" x="250" y="373" text-anchor="end">{entr.short}</text>
					<text class="pm" x="250" y="393" text-anchor="end">{runs(entr.map_note).map((x) => <tspan class={x.cf ? "cf" : undefined}>{x.text}</tspan>)}</text>
				</a>
			)}
			{emd && (
				<a class="m-lk ap lb" href={href("emdash")} data-l={emd.slug} aria-label={emd.short}>
					<rect class="wfr" x="30" y="660" width="200" height="150" rx="6" />
					<rect class="wbar" x="30" y="660" width="200" height="24" rx="6" />
					<rect class="wbar" x="30" y="676" width="200" height="8" />
					<circle class="wd1" cx="42" cy="672" r="3.5" /><circle class="wd2" cx="53" cy="672" r="3.5" /><circle class="wd3" cx="64" cy="672" r="3.5" />
					<text class="wpth" x="220" y="676" text-anchor="end">{L("win_cms", "/_emdash/admin")}</text>
					<rect class="wol" x="30" y="660" width="200" height="150" rx="6" />
					<text class="nm" x="30" y="628">{emd.short}</text>
					<text class="pm" x="30" y="648">{runs(emd.map_note).map((x) => <tspan class={x.cf ? "cf" : undefined}>{x.text}</tspan>)}</text>
				</a>
			)}
			{pres && (
				<a class="m-lk ap lb" href={href("presentacion")} data-l={pres.slug} aria-label={pres.short}>
					<rect class="wfr" x="946" y="335" width="200" height="150" rx="6" />
					<rect class="wbar" x="946" y="335" width="200" height="24" rx="6" />
					<rect class="wbar" x="946" y="351" width="200" height="8" />
					<circle class="wd1" cx="958" cy="347" r="3.5" /><circle class="wd2" cx="969" cy="347" r="3.5" /><circle class="wd3" cx="980" cy="347" r="3.5" />
					<text class="wpth" x="1136" y="351" text-anchor="end">{L("win_site", "/")}</text>
					<rect class="wol" x="946" y="335" width="200" height="150" rx="6" />
					<text class="nm" x="1166" y="371">{pres.short}</text>
					<text class="pm" x="1166" y="391">{runs(pres.map_note).map((x) => <tspan class={x.cf ? "cf" : undefined}>{x.text}</tspan>)}</text>
				</a>
			)}
			<path class="fa" d="M236,735 H392" marker-end="url(#dc-ah)" />
			{/* the page leaves from the network's slab, round the stack, up to its window */}
			<path class="fa" d="M806,545 H896 V430 H938" marker-end="url(#dc-ah)" />
			<g class="who yo">
				{/* the logo in small: the dark plate at +10 degrees behind the grey one, the 2x2 cube in ink */}
				<g class="mark" transform="translate(-32 735)">
					<rect class="mk-d" x="-20" y="-20" width="40" height="40" rx="7" transform="rotate(10)" />
					<rect class="mk-l" x="-20" y="-20" width="40" height="40" rx="7" />
					<path class="mk-c" d="M0,-16.7 L14.5,-8.4 L14.5,8.4 L0,16.7 L-14.5,8.4 L-14.5,-8.4 Z M-14.5,-8.4 L0,0 L14.5,-8.4 M0,0 V16.7 M-7.3,-12.6 L7.3,-4.2 M7.3,-12.6 L-7.3,-4.2 M-7.3,-4.2 V12.6 M-14.5,0 L0,8.4 M7.3,-4.2 V12.6 M14.5,0 L0,8.4" />
				</g>
				<path class="wa2" d="M-6,735 H22" marker-end="url(#dc-ah)" />
				<text class="wh" x="-62" y="726" text-anchor="end">{L("who_edit", "yo edito")}</text>
				{whoSub.map((line, i) => <text class="ws" x="-62" y={746 + i * 18} text-anchor="end">{line}</text>)}
			</g>
			<g class="who tu">
				<path class="wa2" d="M1154,445 H1186" marker-end="url(#dc-ah)" />
				<circle class="ic" cx="1208" cy="445" r="18" />
				<g class="ico pin" transform="translate(1208 445)"><path d="M0,10 C0,10 -8,2.5 -8,-2.5 C-8,-7 -4.4,-10.5 0,-10.5 C4.4,-10.5 8,-7 8,-2.5 C8,2.5 0,10 0,10 Z" /><circle cy="-2.7" r="2.8" /></g>
				<text class="wh" x="1238" y="442">{L("who_see", "tú ves")}</text>
				<text class="ws" x="1238" y="464" data-dc-whoami data-volatile visibility="hidden">{L("who_see_from", "desde")} <tspan class="wloc" data-dc-loc></tspan></text>
			</g>
		</svg>
		<img class="dc-model__im" src="/assets/deconstruyendo/emdash-editor.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" style="left:17.742%;top:55.132%;width:11.828%;height:18.328%" />
		<img class="dc-model__im" src="/assets/deconstruyendo/apertura-cdn.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" style="left:72.461%;top:7.478%;width:11.828%;height:18.328%" />
		</div>
	</div>
	<svg class="dc-model__sm" viewBox="0 0 430 300" aria-hidden="true">
		<rect class="tb" x="38" y="32" width="236" height="236" rx="21.2" transform="rotate(10 156 150)" />
		<rect class="tg" x="38" y="32" width="236" height="236" rx="21.2" />
		{SM.map((s) => (
			<g class={`sl ${s.s}`}>
				<polygon class="ft" points={s.ft} />
				<polygon class="fl" points={s.fl} />
				<polygon class="fr" points={s.fr} />
				<path class="ln" d={s.ln} />
			</g>
		))}
			{SM_LEGEND.filter((r) => by[r.f]).map((r) => <text class="et" transform={r.et} x="0" y="3.5" text-anchor="middle">{r.n}</text>)}
		<text class="cfl" x="312" y="88.0">{L("cloudflare", "Cloudflare")}</text>
		<line class="br" x1="300" y1="98.0" x2="300" y2="202.0" />
		{SM_LEGEND.filter((r) => by[r.f]).map((r) => (
			<g>
				<line class="ld" x1="252.6" y1={r.y} x2="294" y2={r.y} />
				<circle class="dt" cx="300" cy={r.y} r="4" />
				<text class="smn" x="312" y={r.y + 5.5}>{plain(by[r.f].title)}</text>
			</g>
		))}
	</svg>
	<div class="container">
	<nav class="dc-mlist" aria-label={L("map_list_aria", "Mapa de capas")}>
		{groups.map((g) => g.layers.length > 0 && (
			<>
				<p class="dc-mlist__g" set:html={layerHtml(g.label)} />
				{g.layers.map((l, i) => (
					<a class={g.key === "cloudflare" ? "c" : undefined} href={`#${l.slug}`}>
						<b>{g.key === "cloudflare" ? String(i + 1) : "·"}</b>
						<span><Fragment set:html={layerHtml(l.title)} /><small set:html={layerHtml(l.summary)} /></span>
					</a>
				))}
			</>
		))}
	</nav>
	</div>
</div>
