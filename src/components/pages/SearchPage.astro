---
/**
 * The search page, one body for /search and /en/search (#622). Server-rendered
 * on every request: EmDash's FTS5-backed search() over services, pages and
 * posts, in the page's locale. The two routes only pass the locale.
 */
import { search } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { getUiLabels } from "../../utils/ui-labels";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const { locale } = Astro.props as { locale: string };
const en = locale === "en";
const labels = await getUiLabels(locale);

// CMS-driven search labels
const searchTitle = labels.get("search_page", "search_title", en ? "Search" : "Buscar");
const searchLabel = labels.get("search_page", "search_label", en ? "Search articles" : "Buscar artículos");
const searchPlaceholder = labels.get("search_page", "search_placeholder", en ? "Search articles..." : "Buscar artículos...");
const searchHint = labels.get("search_page", "search_hint", en ? "Enter a term to search articles." : "Introduce un término para buscar artículos.");
const searchNoResults = labels.get("search_page", "search_no_results", en ? "No results for" : "Sin resultados para");
const searchResults = labels.get("search_page", "search_results", en ? "result(s) for" : "resultado(s) para");
const searchDescription = labels.get("search_page", "search_description", en ? "Search Server Startup blog" : "Busca en el blog de Server Startup");

// Use EmDash's FTS5-backed search instead of loading all posts into memory.
// This delegates filtering to the database, avoiding O(n × m) substring scans.
// #338: results now span services, pages and posts. Each carries its own
// `collection`, and the route differs per collection — assuming /posts/ for
// everything sent every service and page result to a 404.
const prefix = locale === "en" ? "/en" : "";
const resultHref = (r: { collection?: string; slug?: string; id: string }) => {
	const slug = r.slug || r.id;
	if (r.collection === "posts") return `${prefix}/posts/${slug}`;
	if (r.collection === "pages" && slug === "home") return prefix || "/";
	return `${prefix}/${slug}`;
};

const results = query
	? (await search(query, { collections: ["services", "pages", "posts"], locale, limit: 20 })).items.filter((r) => r.slug !== "home")
	: [];
---

{/* #335: internal search results — Google's own guidance is to keep them out of the
	     index while leaving them crawlable (#335) */}
<Base
	title={query ? `${searchTitle}: ${query}` : searchTitle}
	description={searchDescription}
	robots="noindex"
>
	<section class="search-page" aria-label={searchTitle}>
		<div class="container search-inner">
			<h1>{searchTitle}</h1>

			<form method="get" action={`${locale === "es" ? "" : `/${locale}`}/search`} class="search-form" role="search">
				<label for="search-input" class="sr-only">{searchLabel}</label>
				<input
					type="search"
					id="search-input"
					name="q"
					value={query}
					placeholder={searchPlaceholder}
					class="search-input"
					autofocus
				/>
				<button type="submit" class="btn btn-dark">{searchTitle}</button>
			</form>

			{query && (
				<p class="search-summary">
					{results.length === 0
						? `${searchNoResults} "${query}"`
						: `${results.length} ${searchResults} "${query}"`}
				</p>
			)}

			{results.length > 0 && (
				<div class="search-results">
					{results.map((result) => (
						<PostCard
							title={result.title || ""}
							href={resultHref(result)}
							placeholder={false}
						/>
					))}
				</div>
			)}

			{!query && <p class="text-body search-page__hint">{searchHint}</p>}
		</div>
	</section>
</Base>

<style>
	@import "../../styles/search.css";
</style>
