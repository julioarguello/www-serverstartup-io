---
/**
 * The tag archive, one body for /tag/[slug] and /en/tag/[slug] (#622).
 * Data: utils/pages/blog.ts. The two routes load, answer 404 when the term is
 * unknown or has no posts (#626), and cache.
 */
import { getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { postSlug } from "../../utils/pages/post-path";
import type { ArchiveData } from "../../utils/pages/blog";

type Props = Omit<ArchiveData, "cacheHints">;
const { locale, term, posts } = Astro.props;
const t = Astro.locals.t;
const prefix = locale === "en" ? "/en" : "";

// Fetch tags for display on each post card
const filteredPosts = await Promise.all(
	posts.map(async (post) => {
		const tags = await getEntryTerms("posts", post.data.id, "tag");
		return { post, tags };
	})
);---

<Base
	title={`${t("posts_tagged")} "${term.label}"`}
	description={`${t("all_posts_tagged")} ${term.label}`}
>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">{t("tag_label")}</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{filteredPosts.length}
				{filteredPosts.length === 1 ? t("post_singular") : t("post_plural")}
			</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">{t("no_posts_tag")}</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`${prefix}/posts/${postSlug(post)}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							locale={locale}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	@import "../../styles/archive.css";
</style>
