---
/** /[slug] — a service, or else a CMS page. Body: components/pages/EntryPage.astro; data: utils/pages/entry.ts (#622). */
import EntryPage from "../components/pages/EntryPage.astro";
import { loadEntry } from "../utils/pages/entry";

const page = await loadEntry(Astro.params.slug!, "es");
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
const { cacheHints, ...props } = page;
---

<EntryPage {...props} />
