---
/** /en/about-us — the About page. Body: components/pages/AboutPage.astro; data: utils/pages/about.ts (#622). */
import AboutPage from "../../components/pages/AboutPage.astro";
import { loadAbout } from "../../utils/pages/about";

const page = await loadAbout("about-us", "en");
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
const { cacheHints, ...props } = page;
---

<AboutPage {...props} />
