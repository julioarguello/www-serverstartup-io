---
/** /en/contact — the contact page. Body: components/pages/ContactPage.astro; data: utils/pages/contact.ts (#622). */
import ContactPage from "../../components/pages/ContactPage.astro";
import { loadContact } from "../../utils/pages/contact";

const page = await loadContact("contact", "en");
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
const { cacheHints, ...props } = page;
---

<ContactPage {...props} />
