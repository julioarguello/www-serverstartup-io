---
/** /politica-de-privacidad — the privacy policy. Body: components/pages/PrivacyPage.astro; data: utils/pages/simple.ts (#622). */
import PrivacyPage from "../components/pages/PrivacyPage.astro";
import { loadPage } from "../utils/pages/simple";

const page = await loadPage("politica-de-privacidad", "es");
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
const { cacheHints, ...props } = page;
---

<PrivacyPage {...props} />
