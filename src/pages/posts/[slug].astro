---
/** /posts/[slug] — a blog post. Body: components/pages/PostPage.astro; data: utils/pages/blog.ts (#622). */
import PostPage from "../../components/pages/PostPage.astro";
import { loadPost } from "../../utils/pages/blog";
import { decodeSlug } from "emdash";

const slug = decodeSlug(Astro.params.slug);
const page = slug ? await loadPost(slug, "es") : null;
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
const { cacheHints, ...props } = page;
---

<PostPage {...props} />
