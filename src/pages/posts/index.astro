---
/** /posts — the blog listing. Body: components/pages/PostsPage.astro; data: utils/pages/blog.ts (#622). */
import PostsPage from "../../components/pages/PostsPage.astro";
import { loadPosts } from "../../utils/pages/blog";

const page = await loadPosts("es");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
// #464: the blog is off (#340). An empty section is absent, so no posts is a 404.
if (page.posts.length === 0) return new Response(null, { status: 404 });
const { cacheHints, ...props } = page;
---

<PostsPage {...props} />
