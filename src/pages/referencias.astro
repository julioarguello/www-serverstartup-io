---
/** /referencias — the references page. Body: components/pages/ReferencesPage.astro; data: utils/pages/references.ts (#622). */
import ReferencesPage from "../components/pages/ReferencesPage.astro";
import { loadReferences } from "../utils/pages/references";

const page = await loadReferences("referencias", "es");
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
const { cacheHints, ...props } = page;
---

<ReferencesPage {...props} />
