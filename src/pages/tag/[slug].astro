---
/** /tag/[slug] — the tag archive. Body: components/pages/TagPage.astro; data: utils/pages/blog.ts (#622). */
import TagPage from "../../components/pages/TagPage.astro";
import { loadArchive } from "../../utils/pages/blog";
import { decodeSlug } from "emdash";

const slug = decodeSlug(Astro.params.slug);
const page = slug ? await loadArchive("tag", slug, "es") : null;
if (!page) return Astro.rewrite("/404");
for (const hint of page.cacheHints) if (hint) Astro.cache.set(hint);
// An empty archive is absent, like the blog listing (#464, #626).
if (page.posts.length === 0) return new Response(null, { status: 404 });
const { cacheHints, ...props } = page;
---

<TagPage {...props} />
