{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "www-serverstartup-io",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// #332: Workers Cache — the cache sits IN FRONT of the worker (a hit
	// skips the worker entirely). Cacheability is default-deny in
	// src/middleware.ts; purge-on-publish in src/plugins/cache-purge.ts (#357).
	"cache": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "www-serverstartup-io",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "1b3b50f2-0269-4fe2-8f80-1b55b08bdfa1",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "www-serverstartup-io","preview_bucket_name": "www-serverstartup-io",
		},
	],
	// KV Namespace for Astro sessions
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3d255fdb73a9480b9010cdb5eb7ff4cb",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// #323: Astro's image service transforms through this binding, not through
	// /cdn-cgi/image/. Measured on the preview host: the zone endpoint answers
	// 404 there, because Image Transformations is a ZONE feature and both
	// deploys live on *.workers.dev. The binding runs inside the worker, so it
	// works on either. The adapter can provision it, but bindings are not
	// inherited into named environments (see below), so it is declared here and
	// in each env, like every other binding in this file.
	"images": {
		"binding": "IMAGES",
	},

	// ── CI/CD environments (#191) ─────────────────────────────────────────
	// Bindings are NOT inherited into named environments: each env declares
	// its full set. `preview` owns separate D1/R2/KV so it can never touch
	// production data; `production` pins the real resources explicitly.
	"env": {
		"preview": {
			"name": "www-serverstartup-io-preview",
			"cache": { "enabled": true },
			// #444: the test environment, on its own D1/R2/KV, reachable by a
			// name that says so. `workers_dev` is NOT decorative here — wrangler
			// reads `const defaultWorkersDev = routes.length === 0`, so declaring
			// a route turns the *.workers.dev hostname OFF unless this line says
			// otherwise, and deploy-preview.yml verifies against that hostname.
			"workers_dev": true,
			"routes": [{ "pattern": "preview.serverstartup.dev", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "www-serverstartup-io-preview",
					"database_id": "17f35592-7a2e-4270-bb5f-1d711198255a",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "www-serverstartup-io-preview",
				},
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "954d2ce62bad46f99508dae829ac4af2",
				},
			],
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
			],
			"images": {
				"binding": "IMAGES",
			},
		},
		"production": {
			"name": "www-serverstartup-io",
			"cache": { "enabled": true },
			// #444: NOT a second test environment — this hostname serves the
			// production worker and the production D1, and /_emdash/admin
			// through it edits live content. It exists for two things: to
			// rehearse the §3 custom-domain step of docs/production-cutover.md
			// on a domain nobody depends on, and as a standing A/B probe for the
			// Spanish ISP block, because it answers from the zone's own anycast
			// range (104.21.x.x / 172.67.x.x) while *.workers.dev answers from
			// 188.114.9x.x. One worker, two ranges: when one goes quiet, the
			// other says whether the cause is the network or the site.
			//
			// The apex serverstartup.dev is deliberately absent. A custom domain
			// binds the hostname straight to the worker, so the apex would answer
			// 200 instead of 301 — the #334 defect moved from the trailing slash
			// to the host. It belongs in a Redirect Rule, which is a dashboard
			// action, not a config one.
			//
			// `workers_dev` as above: without it, declaring a route silently
			// switches off the hostname deploy-production.yml polls for D1
			// migrations and then verifies.
			"workers_dev": true,
			"routes": [{ "pattern": "www.serverstartup.dev", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "www-serverstartup-io",
					"database_id": "1b3b50f2-0269-4fe2-8f80-1b55b08bdfa1",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "www-serverstartup-io",
				},
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "3d255fdb73a9480b9010cdb5eb7ff4cb",
				},
			],
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
			],
			"images": {
				"binding": "IMAGES",
			},
		},
	},
}
